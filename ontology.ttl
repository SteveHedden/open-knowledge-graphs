@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap:    <http://usefulinc.com/ns/doap#> .
@prefix okg:     <https://openknowledgegraphs.com/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:  <https://schema.org/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://openknowledgegraphs.com/ontology>
    a owl:Ontology ;
    dcterms:title "Open Knowledge Graphs structural ontology"@en ;
    dcterms:description "Stable structural classes, properties, alignments, and SHACL policy for the Open Knowledge Graphs catalog."@en ;
    dcterms:issued "2026-08-13"^^xsd:date ;
    dcterms:modified "2026-08-24"^^xsd:date ;
    owl:versionInfo "0.2.0" ;
    vann:preferredNamespacePrefix "okg" ;
    vann:preferredNamespaceUri "https://openknowledgegraphs.com/ontology#" .

okg:Resource a rdfs:Class ;
    rdfs:label "Resource" ;
    rdfs:comment "Abstract base class for all catalog entries." .

okg:Ontology a rdfs:Class ;
    rdfs:subClassOf okg:Resource ;
    rdfs:label "Ontology" ;
    rdfs:comment "Formal ontology resource." .

okg:ControlledVocabulary a rdfs:Class ;
    rdfs:subClassOf okg:Resource ;
    rdfs:label "Controlled Vocabulary" ;
    rdfs:comment "Controlled vocabulary resource." .

okg:Taxonomy a rdfs:Class ;
    rdfs:subClassOf okg:Resource ;
    rdfs:label "Taxonomy" ;
    rdfs:comment "Taxonomic classification resource." .

okg:KnowledgeGraph a rdfs:Class ;
    rdfs:subClassOf okg:Resource ;
    rdfs:label "Knowledge Graph" ;
    rdfs:comment "Knowledge graph resource." .

okg:OntologyLanguage a rdfs:Class ;
    rdfs:subClassOf okg:Resource ;
    rdfs:label "Ontology Language" ;
    rdfs:comment "A formal language used to define and represent ontologies." .

okg:Standard a rdfs:Class ;
    rdfs:subClassOf okg:Resource, dcterms:Standard ;
    rdfs:label "Standard" ;
    rdfs:comment "A reviewed technical standard used in knowledge-graph and semantic-web systems." .

okg:Software a rdfs:Class ;
    rdfs:subClassOf okg:Resource ;
    rdfs:label "Software" ;
    rdfs:comment "Semantic or knowledge graph software/tooling resource." ;
    rdfs:seeAlso doap:Project, schema:SoftwareApplication .

okg:License a rdfs:Class ;
    rdfs:subClassOf dcterms:LicenseDocument ;
    rdfs:label "License" ;
    rdfs:comment "License associated with cataloged resources." .

okg:Category a rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Category" ;
    rdfs:comment "Domain category for classifying ontologies and vocabularies." .

okg:SoftwareType a rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Software Type" ;
    rdfs:comment "Functional category for classifying semantic web software (e.g. graph database, ontology editor, AI agent tooling)." .

okg:Person a rdfs:Class ;
    rdfs:subClassOf schema:Person, prov:Person ;
    rdfs:label "Person" ;
    rdfs:comment "An individual credited as creator/author/developer of a cataloged resource. Maps to schema:Person in generated JSON-LD." .

okg:Organization a rdfs:Class ;
    rdfs:subClassOf schema:Organization, prov:Organization ;
    rdfs:label "Organization" ;
    rdfs:comment "An evidence-reviewed organization in the OKG ecosystem registry or credited as a producer of a cataloged resource." .

okg:CareerSource a rdfs:Class ;
    rdfs:subClassOf dcat:DataService ;
    rdfs:label "Career source" ;
    rdfs:comment "An evidence-reviewed official career or ATS service used by the bounded KG Jobs ingestion pipeline." .

okg:jobsProductionEnabled a rdf:Property ;
    rdfs:domain schema:Organization ;
    rdfs:range xsd:boolean ;
    rdfs:label "jobs production enabled" ;
    rdfs:comment "True only when an organization is explicitly approved to activate its reviewed career sources in the production KG Jobs pipeline; the organization identity never supplies classification evidence." .

okg:classificationDimension a rdf:Property ;
    rdfs:domain owl:Class ;
    rdfs:range xsd:string ;
    rdfs:label "classification dimension" ;
    rdfs:comment "Distinguishes reviewed organization kind classes from reviewed ecosystem role classes." .

okg:SourceMapping a rdfs:Class ;
    rdfs:label "Source mapping" ;
    rdfs:comment "Declarative mapping between a source schema and OKG's normalized model." .

okg:SourceClassMapping a rdfs:Class ;
    rdfs:subClassOf okg:SourceMapping ;
    rdfs:label "Source class mapping" ;
    rdfs:comment "Mapping from a source class identifier to an OKG class." .

okg:SourcePropertyMapping a rdfs:Class ;
    rdfs:subClassOf okg:SourceMapping ;
    rdfs:label "Source property mapping" ;
    rdfs:comment "Mapping from a source property identifier to an OKG term or normalized extraction field." .

okg:SourceEligibilityPolicy a rdfs:Class ;
    rdfs:subClassOf okg:SourceMapping ;
    rdfs:label "Source eligibility policy" ;
    rdfs:comment "Declarative source-specific rules that determine which raw source candidates may enter an OKG catalog." .

okg:SourceExclusion a rdfs:Class ;
    rdfs:label "Source exclusion" ;
    rdfs:comment "Reviewed decision that permanently excludes a source entity from automatic catalog eligibility." .

okg:SourceEligibilityException a rdfs:Class ;
    rdfs:label "Source eligibility exception" ;
    rdfs:comment "Reviewed decision allowing a source entity to override a general eligibility rule without overriding a confirmed exclusion." .

okg:SourceInclusion a rdfs:Class ;
    rdfs:subClassOf okg:SourceMapping ;
    rdfs:label "Source inclusion" ;
    rdfs:comment "Reviewed source entity included directly in a catalog when broad class traversal would be unsafe." .

okg:RecommendationExemplar a rdfs:Class ;
    rdfs:subClassOf okg:SourceMapping ;
    rdfs:label "recommendation exemplar" ;
    rdfs:comment "Reviewed source relationship that must remain an explainable recommendation when both records and the claim remain eligible." .

okg:title a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:title, schema:name ;
    rdfs:label "title" ;
    rdfs:comment "Display name of a resource." .

okg:description a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:description, schema:description ;
    rdfs:label "description" ;
    rdfs:comment "Short human-readable description of a resource." .

okg:alias a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf skos:altLabel, schema:alternateName ;
    rdfs:label "alias" ;
    rdfs:comment "Alternate name or abbreviation for a resource, sourced from Wikidata skos:altLabel." .

okg:category a rdf:Property ;
    rdfs:range okg:Category ;
    rdfs:subPropertyOf dcterms:subject ;
    rdfs:label "category" ;
    rdfs:comment "Domain category for an ontology or vocabulary." .

okg:softwareType a rdf:Property ;
    rdfs:domain okg:Software ;
    rdfs:range okg:SoftwareType ;
    rdfs:label "software type" ;
    rdfs:comment "Functional category for a semantic web software resource." .

okg:homepage a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:subPropertyOf schema:url ;
    rdfs:label "homepage" ;
    rdfs:comment "Official website URL for a resource." .

okg:hasLicense a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:range okg:License ;
    rdfs:subPropertyOf dcterms:license ;
    rdfs:label "has license" ;
    rdfs:comment "Links a resource to one or more license instances." .

okg:partOf a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:range xsd:string ;
    rdfs:label "part of" ;
    rdfs:comment "Single parent label retained as a compatibility projection; canonical parent identities use dcterms:isPartOf IRIs." .

okg:wikidataId a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:subPropertyOf schema:sameAs ;
    rdfs:label "wikidata id" ;
    rdfs:comment "IRI of the corresponding Wikidata entity page." .

okg:latestVersion a rdf:Property ;
    rdfs:domain okg:Software ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:softwareVersion ;
    rdfs:label "latest version" ;
    rdfs:comment "Most recent known software version string." .

okg:releaseDate a rdf:Property ;
    rdfs:domain okg:Software ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf schema:datePublished ;
    rdfs:label "release date" ;
    rdfs:comment "Date of the latest software release." .

okg:licenseName a rdf:Property ;
    rdfs:domain okg:License ;
    rdfs:range xsd:string ;
    rdfs:label "license name" ;
    rdfs:comment "Display name of a license." .

okg:creator a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:subPropertyOf dcterms:creator, schema:creator ;
    rdfs:label "creator" ;
    rdfs:comment "Links a cataloged resource to a person or organization credited with creating it." .

okg:githubProfile a rdf:Property ;
    rdfs:domain okg:Person ;
    rdfs:label "GitHub profile" ;
    rdfs:comment "Links a person to their GitHub profile IRI." .

okg:googleScholarProfile a rdf:Property ;
    rdfs:domain okg:Person ;
    rdfs:label "Google Scholar profile" ;
    rdfs:comment "Links a person to their Google Scholar profile IRI." .

okg:namespaceURI a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:label "namespace URI" ;
    rdfs:comment "Namespace IRI associated with a semantic resource." .

okg:programmingLanguage a rdf:Property ;
    rdfs:domain okg:Software ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:programmingLanguage ;
    rdfs:label "programming language" ;
    rdfs:comment "Programming language in which a software resource is implemented." .

okg:relatedTo a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:range okg:Resource ;
    rdfs:subPropertyOf dcterms:relation ;
    rdfs:label "related to" ;
    rdfs:comment "Links a cataloged resource to another related cataloged resource." .

okg:uses a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:range rdfs:Resource ;
    rdfs:subPropertyOf dcterms:relation ;
    rdfs:label "uses" ;
    rdfs:comment "Directional link preserving a source Wikidata uses claim as an IRI." .

okg:sourceType a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:range rdfs:Resource ;
    rdfs:label "source type" ;
    rdfs:comment "Exact direct source type identity, kept distinct from normalized rdf:type." .

okg:sourceRepo a rdf:Property ;
    rdfs:domain okg:Resource ;
    rdfs:subPropertyOf schema:codeRepository ;
    rdfs:label "source repository" ;
    rdfs:comment "Source-code repository IRI for a cataloged resource." .

okg:conceptClass a rdf:Property ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:range rdfs:Class ;
    rdfs:label "concept class" ;
    rdfs:comment "OKG compatibility class used for concepts in a controlled scheme." .

okg:classificationPredicate a rdf:Property ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:range rdf:Property ;
    rdfs:label "classification predicate" ;
    rdfs:comment "OKG predicate used to assign a concept from a controlled scheme." .

okg:urlSlug a rdf:Property ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:string ;
    rdfs:label "URL slug" ;
    rdfs:comment "Stable URL-filter value used by derived web projections." .

okg:sortOrder a rdf:Property ;
    rdfs:range xsd:integer ;
    rdfs:label "sort order" ;
    rdfs:comment "Stable presentation and processing order for declarative configuration entries." .

okg:sourceDataset a rdf:Property ;
    rdfs:domain okg:SourceMapping ;
    rdfs:range dcat:Dataset ;
    rdfs:label "source dataset" ;
    rdfs:comment "Dataset whose schema identifier is described by a mapping." .

okg:catalogDataset a rdf:Property ;
    rdfs:domain okg:SourceMapping ;
    rdfs:range dcat:Dataset ;
    rdfs:label "catalog dataset" ;
    rdfs:comment "Generated OKG dataset to which a source mapping applies." .

okg:sourceClassId a rdf:Property ;
    rdfs:domain okg:SourceClassMapping ;
    rdfs:range xsd:string ;
    rdfs:label "source class identifier" ;
    rdfs:comment "Identifier of a class in the source dataset." .

okg:sourcePropertyId a rdf:Property ;
    rdfs:domain okg:SourcePropertyMapping ;
    rdfs:range xsd:string ;
    rdfs:label "source property identifier" ;
    rdfs:comment "Identifier of a property in the source dataset." .

okg:targetTerm a rdf:Property ;
    rdfs:domain okg:SourceMapping ;
    rdfs:range rdfs:Resource ;
    rdfs:label "target term" ;
    rdfs:comment "OKG or external semantic term targeted by a source mapping." .

okg:projectionValue a rdf:Property ;
    rdfs:domain okg:SourceMapping ;
    rdfs:range xsd:string ;
    rdfs:label "projection value" ;
    rdfs:comment "Stable compatibility value emitted for a mapped class in derived JSON." .

okg:normalizedField a rdf:Property ;
    rdfs:domain okg:SourcePropertyMapping ;
    rdfs:range xsd:string ;
    rdfs:label "normalized field" ;
    rdfs:comment "Source-independent extraction field populated by a source property." .

okg:valueKind a rdf:Property ;
    rdfs:domain okg:SourcePropertyMapping ;
    rdfs:range xsd:string ;
    rdfs:label "value kind" ;
    rdfs:comment "Expected structural kind of values supplied by a source property." .

okg:cardinality a rdf:Property ;
    rdfs:domain okg:SourcePropertyMapping ;
    rdfs:range xsd:string ;
    rdfs:label "cardinality" ;
    rdfs:comment "Expected source cardinality used to document extraction assumptions." .

okg:termComponentMarker a rdf:Property ;
    rdfs:domain okg:SourceEligibilityPolicy ;
    rdfs:range rdfs:Resource ;
    rdfs:label "term or component marker" ;
    rdfs:comment "Direct source class whose presence marks an entity as an individual term or ontology component for eligibility evaluation." .

okg:sourceExclusion a rdf:Property ;
    rdfs:domain okg:SourceEligibilityPolicy ;
    rdfs:range okg:SourceExclusion ;
    rdfs:label "source exclusion" ;
    rdfs:comment "Connects an eligibility policy to a reviewed source-entity exclusion." .

okg:eligibilityException a rdf:Property ;
    rdfs:domain okg:SourceEligibilityPolicy ;
    rdfs:range okg:SourceEligibilityException ;
    rdfs:label "eligibility exception" ;
    rdfs:comment "Connects an eligibility policy to a reviewed QID-specific exception." .

okg:sourceEntity a rdf:Property ;
    rdfs:range rdfs:Resource ;
    rdfs:label "source entity" ;
    rdfs:comment "Public source entity governed by an exclusion or exception decision." .

okg:sourceObject a rdf:Property ;
    rdfs:domain okg:RecommendationExemplar ;
    rdfs:range rdfs:Resource ;
    rdfs:label "source object" ;
    rdfs:comment "Object entity of a reviewed source relationship exemplar." .

okg:sourcePropertyMapping a rdf:Property ;
    rdfs:domain okg:RecommendationExemplar ;
    rdfs:range okg:SourcePropertyMapping ;
    rdfs:label "source property mapping" ;
    rdfs:comment "Declared source predicate supporting a reviewed recommendation exemplar." .

okg:ResourceShape a sh:NodeShape ;
    sh:targetClass okg:Resource ;
    sh:property [
        sh:path okg:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path okg:homepage ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path okg:sourceRepo ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path okg:namespaceURI ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path okg:description ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path okg:category ;
        sh:nodeKind sh:IRI ;
        sh:class okg:Category ;
    ] ;
    sh:property [
        sh:path okg:hasLicense ;
        sh:nodeKind sh:IRI ;
        sh:class okg:License ;
    ] ;
    sh:property [
        sh:path okg:creator ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path okg:relatedTo ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path okg:uses ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path okg:sourceType ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path okg:partOf ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path okg:wikidataId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] .

okg:OntologyShape a sh:NodeShape ;
    sh:targetClass okg:Ontology ;
    sh:node okg:ResourceShape .

okg:ControlledVocabularyShape a sh:NodeShape ;
    sh:targetClass okg:ControlledVocabulary ;
    sh:node okg:ResourceShape .

okg:TaxonomyShape a sh:NodeShape ;
    sh:targetClass okg:Taxonomy ;
    sh:node okg:ResourceShape .

okg:KnowledgeGraphShape a sh:NodeShape ;
    sh:targetClass okg:KnowledgeGraph ;
    sh:node okg:ResourceShape .

okg:OntologyLanguageShape a sh:NodeShape ;
    sh:targetClass okg:OntologyLanguage ;
    sh:node okg:ResourceShape .

okg:StandardShape a sh:NodeShape ;
    sh:targetClass okg:Standard ;
    sh:node okg:ResourceShape .

okg:SoftwareShape a sh:NodeShape ;
    sh:targetClass okg:Software ;
    sh:node okg:ResourceShape ;
    sh:property [
        sh:path okg:latestVersion ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path okg:releaseDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path okg:softwareType ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class okg:SoftwareType ;
    ] ;
    sh:property [
        sh:path okg:programmingLanguage ;
        sh:datatype xsd:string ;
    ] .

okg:PersonShape a sh:NodeShape ;
    sh:targetClass okg:Person ;
    sh:property [
        sh:path okg:githubProfile ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path okg:googleScholarProfile ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] .

okg:LicenseShape a sh:NodeShape ;
    sh:targetClass okg:License ;
    sh:property [
        sh:path okg:licenseName ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

okg:Activity a rdfs:Class ; rdfs:label "Activity" ; rdfs:comment "A shared activity or use-case concept." .

okg:TagEntity a rdfs:Class ; rdfs:label "TagEntity" ; rdfs:comment "An identified resource, technology, language or model available for tagging." .

okg:TagAssignment a rdfs:Class ; rdfs:label "TagAssignment" ; rdfs:comment "An evidence-backed proposed or accepted classification assignment." .

okg:TagAssessment a rdfs:Class ; rdfs:label "TagAssessment" ; rdfs:comment "A versioned assessment of an applicable subject." .

okg:TagDecision a rdfs:Class ; rdfs:label "TagDecision" ; rdfs:comment "A durable human acceptance or rejection of one subject/dimension/target." .

okg:ProgrammingLanguage a rdfs:Class ; rdfs:label "ProgrammingLanguage" ; rdfs:comment "A programming language entity." .

okg:QueryLanguage a rdfs:Class ; rdfs:label "QueryLanguage" ; rdfs:comment "A query language entity." .

okg:ConstraintLanguage a rdfs:Class ; rdfs:label "ConstraintLanguage" ; rdfs:comment "A constraint language entity." .

okg:KnowledgeOrganizationModel a rdfs:Class ; rdfs:label "KnowledgeOrganizationModel" ; rdfs:comment "A knowledge organization model entity." .

okg:SoftwareFramework a rdfs:Class ; rdfs:label "SoftwareFramework" ; rdfs:comment "A reusable software framework." .

okg:SearchEngine a rdfs:Class ; rdfs:label "SearchEngine" ; rdfs:comment "A search engine software entity." .

okg:usesResource a rdf:Property ; rdfs:label "usesResource" ; rdfs:comment "Evidenced technology use, support or requested skill; not mere mention." .

okg:hasActivity a rdf:Property ; rdfs:label "hasActivity" ; rdfs:comment "An activity performed or supported, or an intended use case." .

okg:tagAssessment a rdf:Property ; rdfs:label "tagAssessment" ; rdfs:comment "Links a subject to its versioned descriptive tag assessment." .

okg:tagAssignment a rdf:Property ; rdfs:label "tagAssignment" ; rdfs:comment "Links an assessment to assignment evidence." .

okg:tagSubject a rdf:Property ; rdfs:label "tagSubject" ; rdfs:comment "The classified subject." .

okg:tagTarget a rdf:Property ; rdfs:label "tagTarget" ; rdfs:comment "The assigned entity or concept." .

okg:tagDimension a rdf:Property ; rdfs:label "tagDimension" ; rdfs:comment "One of tools, activities or domains." .

okg:reviewState a rdf:Property ; rdfs:label "reviewState" ; rdfs:comment "automated, reviewed, suggested or rejected." .

okg:sourceField a rdf:Property ; rdfs:label "sourceField" ; rdfs:comment "Source field supporting the assignment." .

okg:supportingText a rdf:Property ; rdfs:label "supportingText" ; rdfs:comment "Verbatim supporting text from the source field." .

okg:sourceContentHash a rdf:Property ; rdfs:label "sourceContentHash" ; rdfs:comment "Digest of meaningful source content." .

okg:cacheKey a rdf:Property ; rdfs:label "cacheKey" ; rdfs:comment "Digest of source content, vocabulary semantics and method." .

okg:vocabularyVersion a rdf:Property ; rdfs:label "vocabularyVersion" ; rdfs:comment "Version of the shared vocabularies." .

okg:classificationMethod a rdf:Property ; rdfs:label "classificationMethod" ; rdfs:comment "Versioned matching and contextual classification method." .

okg:requirementStatus a rdf:Property ; rdfs:label "requirementStatus" ; rdfs:comment "Internal RDF-only required, preferred, contextual or unspecified evidence." .

okg:requirementGroup a rdf:Property ; rdfs:label "requirementGroup" ; rdfs:comment "Internal RDF-only wording of an alternative requirement group." .

okg:relationContext a rdf:Property ; rdfs:label "relationContext" ; rdfs:comment "uses, supports, requested-skill, performs, intended-use or subject-domain." .

okg:assessmentStatus a rdf:Property ; rdfs:label "assessmentStatus" ; rdfs:comment "pending, deferred, complete, reviewed-empty, insufficient-evidence, excluded-inactive or excluded-not-match; separate from publication state." .

okg:coverageLimited a rdf:Property ; rdfs:label "coverageLimited" ; rdfs:comment "Whether source content is known or suspected to be limited." .

okg:conceptKind a rdf:Property ; rdfs:label "conceptKind" ; rdfs:comment "Activity, use-case or domain." .

okg:discoveryPhrase a rdf:Property ; rdfs:label "discoveryPhrase" ; rdfs:comment "A discovery probe, not an asserted exact synonym." .

okg:catalogPage a rdf:Property ; rdfs:label "catalogPage" ; rdfs:comment "An existing catalog page for a registry identity." .

okg:tagProjection a rdf:Property ; rdfs:label "tagProjection" ; rdfs:comment "Deterministic public JSON projected from accepted RDF assignments; excludes internal requirement metadata." .

okg:decisionReason a rdf:Property ; rdfs:label "decisionReason" ; rdfs:comment "Human rationale for an accepted or rejected assignment." .

# Classification review contract v1 (Task 51)
okg:ClassificationReview a rdfs:Class ; rdfs:label "ClassificationReview" ; rdfs:comment "An immutable, evidence-bound Codex or human review result." .
okg:CorrectionEvidence a rdfs:Class ; rdfs:label "CorrectionEvidence" ; rdfs:comment "The original evidence and term semantics supporting a human correction." .
okg:reviewSchemaVersion a rdf:Property ; rdfs:label "reviewSchemaVersion" ; rdfs:comment "Version of the classification review result contract." .
okg:recordKind a rdf:Property ; rdfs:label "recordKind" ; rdfs:comment "resource, software or jobs." .
okg:reviewOutcome a rdf:Property ; rdfs:label "reviewOutcome" ; rdfs:comment "accepted, reviewed-empty or deferred." .
okg:reviewedBy a rdf:Property ; rdfs:label "reviewedBy" ; rdfs:comment "Public reviewer attribution." .
okg:reviewedAt a rdf:Property ; rdfs:label "reviewedAt" ; rdfs:comment "Review timestamp." .
okg:reviewScope a rdf:Property ; rdfs:label "reviewScope" ; rdfs:comment "JSON array of reviewed dimensions." .
okg:vocabularyContext a rdf:Property ; rdfs:label "vocabularyContext" ; rdfs:comment "JSON object mapping reviewed vocabulary identifiers to meaning hashes." .
okg:correctionsHash a rdf:Property ; rdfs:label "correctionsHash" ; rdfs:comment "Digest of current explicit corrections for the reviewed record." .
okg:unresolvedFinding a rdf:Property ; rdfs:label "unresolvedFinding" ; rdfs:comment "A publishable unresolved decision, not internal reasoning." .
okg:evidenceSnapshot a rdf:Property ; rdfs:label "evidenceSnapshot" ; rdfs:comment "Canonical classification-relevant fields, serialized as a JSON literal in RDF." .
okg:termSemanticsHash a rdf:Property ; rdfs:label "termSemanticsHash" ; rdfs:comment "Digest of the identity and meaning of an assigned term." .
okg:reviewReason a rdf:Property ; rdfs:label "reviewReason" ; rdfs:comment "new, changed or missing." .
okg:appliedReview a rdf:Property ; rdfs:label "appliedReview" ; rdfs:comment "Immutable review result applied to this assessment; not proof of publication." .
okg:reviewedSoftwareType a rdf:Property ; rdfs:label "reviewedSoftwareType" ; rdfs:comment "Evidence-bound primary software-type concept." .
okg:softwareTypeSemanticsHash a rdf:Property ; rdfs:label "softwareTypeSemanticsHash" ; rdfs:comment "Meaning hash of the primary software type." .
okg:decisionHash a rdf:Property ; rdfs:label "decisionHash" ; rdfs:comment "Identity of the immutable human decision evidence binding." .

okg:softwareTypeSourceField a rdf:Property ; rdfs:label "software type source field" .
okg:softwareTypeSupportingText a rdf:Property ; rdfs:label "software type supporting text" .
