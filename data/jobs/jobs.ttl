<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-consultant-sustainability-advisory-climate-tech-startup-munich-99268> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-consultant-sustainability-advisory-climate-tech-startup-munich-99268/1>,
        <https://www.arbeitnow.com/jobs/companies/carbmee/senior-consultant-sustainability-advisory-climate-tech-startup-munich-99268> ;
