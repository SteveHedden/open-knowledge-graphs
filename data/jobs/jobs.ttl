    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-account-executive-contech-united-kingdom-256538/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/xyz-reality/account-executive-contech-united-kingdom-256538> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "5d2a18f887b50a9d659b10038fc60aafc1457975f1a9c3c0fc5c61d79e896f39" ;
