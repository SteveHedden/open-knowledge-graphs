    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a1671f93a515db3d04c6017838a09874516680350902b0ce232b44be75e0eec6" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
