    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-customer-success-smb-french-market-paris-115050/1>,
        <https://www.arbeitnow.fr/jobs/companies/lexroom/customer-success-smb-french-market-paris-115050> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "91af70e85e5cf1457c57e68adcafc53fbddd8107bdd86c4ef24da9d7c9419572" ;
