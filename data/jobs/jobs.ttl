    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-design-strategy-munchen-293819/1>,
