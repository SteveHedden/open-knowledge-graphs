    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-solutions-engineer-london-389135/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/carta/solutions-engineer-london-389135> ;
