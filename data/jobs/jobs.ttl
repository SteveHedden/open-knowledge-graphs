        <https://www.arbeitnow.com/jobs/companies/lexroom/customer-success-manager-german-market-berlin-407300> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "43f1d13b87fe639cb69ac0c0e3d621ca5ef2deb13552865e25c166596aa8109d" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
