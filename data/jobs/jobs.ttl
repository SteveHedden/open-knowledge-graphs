    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://job-boards.greenhouse.io/relationalai/jobs/6175260004>,
        <https://openknowledgegraphs.com/jobs/live/occurrence/firstparty%3Afirst-party-relationalai%3A6175260004/1> ;
