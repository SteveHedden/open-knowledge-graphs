    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7c5e8ca6a8c4e48dc3d60a84300d00ce079aeb633d23fc6b040ddb3cbf1f976f" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
