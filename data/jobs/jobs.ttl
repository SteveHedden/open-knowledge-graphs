<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-technical-product-manager-all-gender-berlin-373703> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-technical-product-manager-all-gender-berlin-373703/1>,
