        <https://www.arbeitnow.com/jobs/companies/european-it-consultancy-eitco-gmbh/devops-engineer-application-management-services-berlin-bonn-essen-68664> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "4a8c2ff4c23a802267d7f8f60f6573b2e43490029f0689ae5eb397e360e52e23" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
