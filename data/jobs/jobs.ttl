<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-werkstudent-store-promoter-hannover-flagship-store-hannover-452462> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-store-promoter-hannover-flagship-store-hannover-452462/1>,
