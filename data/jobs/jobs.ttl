<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-talent-partner-strategic-account-management-london-291022> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-talent-partner-strategic-account-management-london-291022/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/dex/talent-partner-strategic-account-management-london-291022> ;
