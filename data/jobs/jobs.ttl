<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-accounts-payable-ap-senior-analyst-paris-paris-397444> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-accounts-payable-ap-senior-analyst-paris-paris-397444/1>,
        <https://www.arbeitnow.fr/jobs/companies/doctolib/accounts-payable-ap-senior-analyst-paris-paris-397444> ;
