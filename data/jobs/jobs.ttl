        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-security-engineer-detection-and-response-london-264137/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/hackerone/senior-security-engineer-detection-and-response-london-264137> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "86c7dfc2bc411f335d1163a69aad6af721282c05a0e49092053633aacee6f549" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
