    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b4806664bf21840df569002f8c94729455fee3acfbeb065f26309e94ae78abb1" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
