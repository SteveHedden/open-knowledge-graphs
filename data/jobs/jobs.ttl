    schema:jobLocationType "ON_SITE" ;
    schema:title "Werkstudent – Compliance Management (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/ottonova/werkstudent-compliance-management-munchen-11808> .

