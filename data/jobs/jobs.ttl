    schema:jobLocationType "ON_SITE" ;
    schema:title "(Senior) Collection Merchandiser Shoes (f/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/aeyde/senior-collection-merchandiser-shoes-berlin-435353> .

