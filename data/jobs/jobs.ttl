    kgjobs:active true ;
    kgjobs:canonicalFingerprint "73ec191bfd5f19915a9925c4106de7892392a002928c43b6033fbd139648fe71" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
