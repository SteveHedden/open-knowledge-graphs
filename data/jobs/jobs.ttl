<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-software-engineer-windows-desktop-applications-bordeaux-france-337689> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
