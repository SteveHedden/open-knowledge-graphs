<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-tech-advisory-senior-consultant-munchen-59206> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-tech-advisory-senior-consultant-munchen-59206/1>,
