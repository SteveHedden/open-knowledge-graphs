<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-werkstudent-einkauf-fur-tiefbau-und-planungsleistungen-im-glasfaserausbau-295556> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
