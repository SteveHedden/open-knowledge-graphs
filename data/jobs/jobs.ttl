<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-werkstudent-online-marketing-pr-berlin-250435> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-online-marketing-pr-berlin-250435/1>,
        <https://www.arbeitnow.com/jobs/companies/echo-poster-gmbh/werkstudent-online-marketing-pr-berlin-250435> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6993adaa5cd47dca1db393c6d911f555c7584a3a040db5dc093d650288df6ea9" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-online-marketing-pr-berlin-250435/1> ;
    kgjobs:sourceRecordId "werkstudent-online-marketing-pr-berlin-250435" ;
    schema:datePosted "2026-09-08"^^xsd:date ;
    schema:description "Echo Poster GmbH · Berlin-Charlottenburg, hybrid/remote · Werkstudent, Aushilfe Die meisten Werkstudenten-Jobs im Marketing heißen: Slides schieben, Reportings füllen. Bei uns schreibst du Redaktionen und Blogs an, bringst unsere Kampagnen dort unter und siehst danach, was der Beitrag bei Google für uns bewegt hat. ECHO POSTER ist eine Berliner Spezialagentur für Außenwerbung. Seit 2008 bringen wir Plakate, digitale Screens, Guerilla-Aktionen und Sonderbauten in Deutschland, UK und Italien auf die Straße. Unsere Kampagnen hängen nicht in Pitch-Decks, sie hängen in der Stadt. Das ist dein Rohstoff, denn darüber schreiben Medien gern. Aufgaben Du baust unsere Presse- und Medienlisten auf und hältst sie sauber: Fachmedien, Regionalpresse, Blogs, Verbände etc. Du machst aus unseren Kampagnen PR-Showcases. Du hältst nach, was deine Platzierungen bewirken: Erwähnungen, Backlinks, Rankings Du pitchst Gastbeiträge und Cases Du prüfst jede Zielseite auf Qualität, bevor wir anfragen Du monitorst die Wirkung unserer der Placements Qualifikation Du bist immatrikuliert - zum Beispiel in Kommunikation, Marketing, Medien oder Journalismus. Das Fach ist uns weniger wichtig als deine Schreibe Du schreibst sehr gutes Deutsch und traust dich, fremde Menschen anzuschreiben. Per Mail, auf LinkedIn oder greifst, wenn es sein muss auch mal zum Hörer Du arbeitest mit Listen-Disziplin. Eine Outreach-Liste mit 80 Kontakten und sauberem Status macht dir keine Angst, sie macht dir Freude SEO-Grundwissen ist ein Plus, kein Muss. Was ein Backlink ist, solltest du wissen, den Rest bringen wir dir bei Dein Englisch ist gut genug, um auch mal eine UK-Redaktion anzuschreiben Benefits Du lernst Digitale PR und Off-Page-SEO als Handwerk, nicht als Theorie. Du lernst was Prospecting, Pitch, Platzierung und Wirkungsmessung ist Du arbeitest mit Profi-Werkzeugen: Ahrefs, Google Search Console, HubSpot Du erfährst wie eine Werbeagentur von innen funktioniert, mit direktem Draht zur Geschäftsführung und einem hilfsbereiten Team Deine Arbeit ist keine Übungsaufgabe. Veröffentlichungen haben deinen Fingerabdruck Deine Arbeitszeiten passen sich deinem Stundenplan an Remote oder vor Ort - du entscheidest Kostenlose Getränke - na logisch und jeden Mittwoch authentischer Thai-Lunch mit dem Team Hardware, mit der du flüssig arbeiten kannst Last but not least - Wer arbeiten kann, kann auch feiern. Team Events gehören selbstverständlich auch dazu Schick uns deinen Lebenslauf und beantworte eine Frage: Welches Medium würdest du für eine Außenwerbe-Agentur als erstes anschreiben, und mit welchem konkreten Themenvorschlag? Ein paar gute Sätze reichen uns aus. Wir freuen uns auf deine Bewerbung! Find more English Speaking Jobs in Germany on Arbeitnow" ;
    schema:employmentType "Working student" ;
    schema:hiringOrganization kgjd:employer-echo-poster-gmbh ;
