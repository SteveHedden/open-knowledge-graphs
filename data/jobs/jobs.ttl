    prov:generatedAtTime "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-principal-enterprise-architect-munich-425728/1>,
        <https://www.arbeitnow.com/jobs/companies/celonis/principal-enterprise-architect-munich-425728> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f2cd541e8c0311ff7ecbcad8af2023f547cf884bb63bc2fced37351ba44b4944" ;
