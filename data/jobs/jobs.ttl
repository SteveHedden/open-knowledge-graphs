    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-online-marketing-berlin-363002/1>,
        <https://www.arbeitnow.com/jobs/companies/esanum/werkstudent-online-marketing-berlin-363002> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6a4f20a5c040317567f0be4280a6a3843fb22f5f395f17a71dfa72619a7e9967" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
