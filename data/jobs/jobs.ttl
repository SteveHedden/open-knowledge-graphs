    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-data-platform-engineer-london-24003/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/magentic/data-platform-engineer-london-24003> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a13c0226d641cdb8e596132512ba118aad1e96e890f929c8ce679c8dea3d2eee" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
