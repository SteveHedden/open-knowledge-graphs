<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-account-lead-influencer-marketing-brand-strategy-munich-492454> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-account-lead-influencer-marketing-brand-strategy-munich-492454/1>,
        <https://www.arbeitnow.com/jobs/companies/ykone-gmbh/account-lead-influencer-marketing-brand-strategy-munich-492454> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e68204fdf35d1004395b755355e5108ac9ce58a958d0a698e759119f31b0dc1d" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
