<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-alliances-director-france-paris-316257> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-alliances-director-france-paris-316257/1>,
        <https://www.arbeitnow.fr/jobs/companies/anaplan/alliances-director-france-paris-316257> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "9221e0fb0280681c731f45f1e77e9ee1f034b6d6fe19429b2cbb188e07d74628" ;
