        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-bi-developer-munich-306496/1>,
        <https://www.arbeitnow.com/jobs/companies/prime-hr-agentur/senior-bi-developer-munich-306496> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "862fbfb9d0d0e0285c29aa3b16341fe2bdef04dbff067cbf3b5d1ffaa8b692c8" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
