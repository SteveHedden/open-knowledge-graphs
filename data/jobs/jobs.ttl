    schema:jobLocationType "ON_SITE" ;
    schema:title "Werkstudent (m/w/d) Social Media Marketing / PR" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/gusti-leder-gmbh/werkstudent-social-media-marketing-pr-rostock-198339> .

