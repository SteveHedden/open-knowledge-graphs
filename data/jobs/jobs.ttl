<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-founding-growth-partner-ai-marketing-lead-berlin-294314> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-founding-growth-partner-ai-marketing-lead-berlin-294314/1>,
        <https://www.arbeitnow.com/jobs/companies/accessful-gmbh/founding-growth-partner-ai-marketing-lead-berlin-294314> ;
