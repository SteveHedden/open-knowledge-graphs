<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-werkstudent-projektkoordination-wohnungswirtschaft-ne3-188110> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-werkstudent-projektkoordination-wohnungswirtschaft-ne3-188110/1>,
