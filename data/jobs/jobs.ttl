    prov:wasDerivedFrom <https://himalayas.app/companies/samsara/jobs/senior-marketing-analytics-manager-bi-data-architecture>,
        <https://openknowledgegraphs.com/jobs/live/occurrence/himalayas-b3ffed01df398cb9/1> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b3ffed01df398cb9d9908e14de118f20f17ad4259fff7a4fd21830fdb40099e1" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T23:28:25+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
