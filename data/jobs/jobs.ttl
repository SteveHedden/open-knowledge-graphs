    prov:generatedAtTime "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-accounting-solutions-consultant-342112/1>,
        <https://www.arbeitnow.fr/jobs/companies/rillet/remote-accounting-solutions-consultant-342112> ;
