        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-inbound-sales-paris-france-266555/1>,
        <https://www.arbeitnow.fr/jobs/companies/alan/inbound-sales-paris-france-266555> ;
