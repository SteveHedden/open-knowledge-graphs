        <https://www.arbeitnow.co.uk/jobs/companies/deliveroo/software-engineer-backend-bi-platform-london-234160> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7b5424e8ba1426105729a1c49e78a08b71559a7042a6333e79339b2e4b1f46f5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
