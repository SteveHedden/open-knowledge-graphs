    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-working-student-ai-support-operations-frankfurt-am-main-436929/1>,
        <https://www.arbeitnow.com/jobs/companies/statworx/working-student-ai-support-operations-frankfurt-am-main-436929> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "27ae94f328640001d8dff9215c8901efc73243d33fe3f7fad90d441384b1b5c4" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
