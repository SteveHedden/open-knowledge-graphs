    schema:jobLocationType "ON_SITE" ;
    schema:title "Werkstudent - Technisches Projektmanagement" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/voltir/werkstudent-technisches-projektmanagement-berlin-370633> .

