    schema:jobLocationType "ON_SITE" ;
    schema:title "Senior Account Manager:in (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/we-are-social-1/senior-account-managerin-berlin-473717> .

