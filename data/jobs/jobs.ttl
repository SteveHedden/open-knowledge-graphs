    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-data-engineer-dusseldorf-159968/1>,
        <https://www.arbeitnow.com/jobs/companies/dishdigital/data-engineer-dusseldorf-159968> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a84ef4e1b5b1fb1ef044332f3dd9d704fd7756ed59b91389def1ecc2502b08a2" ;
    kgjobs:classification "not_match" ;
