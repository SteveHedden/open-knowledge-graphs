<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-consultant-london-390731> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-consultant-london-390731/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/ogilvy-uk/senior-consultant-london-390731> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "971ca7d8dae0a3233f68173aa76d7e190ce09a95ff396a2dcdf56c495f3fb665" ;
    kgjobs:classification "not_match" ;
