    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-programmatic-manager-display-paid-social-bonn-169784/1>,
