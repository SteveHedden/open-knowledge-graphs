    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-tech-lead-ia-h-f-paris-370675/1>,
        <https://www.arbeitnow.fr/jobs/companies/thiga/tech-lead-ia-h-f-paris-370675> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "cf76c021fe6333abfb76f0c9e4ac414b4d0158bf8c65c2a7411d123bac63bf6c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
