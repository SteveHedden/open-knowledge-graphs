<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-software-engineer-core-experiences-frankfurt-germany-281069> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-software-engineer-core-experiences-frankfurt-germany-281069/1>,
        <https://www.arbeitnow.com/jobs/companies/speechify/senior-software-engineer-core-experiences-frankfurt-germany-281069> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6fbec0598af0427b96640817adfcc7189b332b77f4c9e15b29ae6f2cdb8207b0" ;
    kgjobs:classification "not_match" ;
