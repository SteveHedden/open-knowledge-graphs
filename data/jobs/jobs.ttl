    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-strategic-alliances-director-492077/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/redwoodsoftware/strategic-alliances-director-492077> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "41c4967cf78f9be690dea4bf42e7356975ed26855ccbe4a1e775abc66545afd3" ;
