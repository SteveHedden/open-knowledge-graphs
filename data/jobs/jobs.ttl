<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-head-of-vip-influencers-pr-london-130731> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-head-of-vip-influencers-pr-london-130731/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/tala-we-are-tala-ltd/head-of-vip-influencers-pr-london-130731> ;
    kgjobs:active true ;
