    schema:jobLocationType "ON_SITE" ;
    schema:title "Product Manager Grower Experience (m/w/d)" ;
    schema:url <https://www.arbeitnow.fr/jobs/companies/bridgemaker-gmbh/product-manager-grower-experience-hybrid-356527> .

