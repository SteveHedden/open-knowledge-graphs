<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-backend-engineer-databases-loki-query-germany-remote-136823> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-backend-engineer-databases-loki-query-germany-remote-136823/1>,
        <https://www.arbeitnow.com/jobs/companies/grafanalabs/senior-backend-engineer-databases-loki-query-germany-remote-136823> ;
