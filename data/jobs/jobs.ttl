    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-content-creator-bielefeld-97234/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Performance Content Creator" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/paddy/content-creator-bielefeld-97234> .

