        <https://www.arbeitnow.co.uk/jobs/companies/drata/commercial-account-executive-london-hybrid-london-189478> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c973119413d807d07380b1a0b874c5e030ee8f399781f7c87a4ec8fcec990867" ;
