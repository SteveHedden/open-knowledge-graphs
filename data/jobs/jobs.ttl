    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-legal-operations-manager-london-458444/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/9fin/senior-legal-operations-manager-london-458444> ;
