    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-director-ai-automation-onemedia-germany-munich-249102/1>,
        <https://www.arbeitnow.com/jobs/companies/onemedia-consulting/director-ai-automation-onemedia-germany-munich-249102> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "aa9e086f5b11e2eb7aecf5960cd726a200f67a32f6bdf615572bf82d0cb37040" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
