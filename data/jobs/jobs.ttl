    prov:generatedAtTime "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-azure-cloud-architect-hamburg-427466/1>,
        <https://www.arbeitnow.com/jobs/companies/skaylink/azure-cloud-architect-hamburg-427466> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "fa91200f071f5aaff9b2a44e928a81fc240b89ff2a5896e0503dbc671f72b066" ;
    kgjobs:classification "not_match" ;
