    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-technical-product-manager-hamburg-88855/1>,
        <https://www.arbeitnow.com/jobs/companies/exmox/senior-technical-product-manager-hamburg-88855> ;
