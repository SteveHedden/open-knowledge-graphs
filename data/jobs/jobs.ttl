<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-vfx-artist-new-mobile-game-hamburg-377476> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-vfx-artist-new-mobile-game-hamburg-377476/1>,
        <https://www.arbeitnow.com/jobs/companies/innogames/senior-vfx-artist-new-mobile-game-hamburg-377476> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "89490eec35a98d6b699d758a75f131f7f77236ed9c8a5cca7eab00dfb47212f4" ;
    kgjobs:classification "not_match" ;
