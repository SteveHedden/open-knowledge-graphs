    schema:jobLocationType "ON_SITE" ;
    schema:title "Stage - Data Scientist / Data Analyst (H/F)" ;
    schema:url <https://www.arbeitnow.fr/jobs/companies/sezane-3/stage-data-scientist-data-analyst-h-f-paris-411891> .

