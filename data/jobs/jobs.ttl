    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-founding-sdr-dach-market-berlin-82894/1>,
        <https://www.arbeitnow.com/jobs/companies/vivid/founding-sdr-dach-market-berlin-82894> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a499ec62f5142a4c73eb51db7d9946ae8599a5b7cf649f18ce55f7fc74c6375a" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
