    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-controller-all-genders-koln-167249/1>,
        <https://www.arbeitnow.com/jobs/companies/armedangels/senior-controller-all-genders-koln-167249> ;
