<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-key-account-manager-paris-france-bordeaux-france-marseille-france-annecy-france-53536> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-key-account-manager-paris-france-bordeaux-france-marseille-france-annecy-france-53536/1>,
        <https://www.arbeitnow.fr/jobs/companies/alan/key-account-manager-paris-france-bordeaux-france-marseille-france-annecy-france-53536> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "fab1d46585b890a703fd954ef69df4a1d4ce775582829c2d2010c2a804ac674e" ;
