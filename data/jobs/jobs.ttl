    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-site-reliability-engineer-search-paris-373167/1>,
        <https://www.arbeitnow.fr/jobs/companies/algolia/senior-site-reliability-engineer-search-paris-373167> ;
