        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-programme-associate-munich-or-berlin-19208/1>,
        <https://www.arbeitnow.com/jobs/companies/hypersonica/senior-programme-associate-munich-or-berlin-19208> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a57852f971e7e1ca4375daf65cc9a8a149abb5dcd3e1be13f357661df44bc331" ;
