    kgjobs:active true ;
    kgjobs:canonicalFingerprint "bcb490d6280dddf9067e56be7442dad833f51d486bedfcad2c5792889b698190" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
