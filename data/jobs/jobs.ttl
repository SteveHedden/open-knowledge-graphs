    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6c0e78e616d1a71b42bd359458c7b9d568b1b51bb45ef0bdf131c29559e989c3" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
