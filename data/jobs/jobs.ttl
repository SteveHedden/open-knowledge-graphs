        <https://www.arbeitnow.fr/jobs/companies/mistralai/data-scientist-paris-131655> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "78fe7bc977dcab1e380d1b6ffc61d334e0282a5a00a6b58ee8fdaf5853f1ee65" ;
