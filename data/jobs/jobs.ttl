    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-global-design-director-shark-home-london-341255/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/sharkninjaoperatingllc/global-design-director-shark-home-london-341255> ;
