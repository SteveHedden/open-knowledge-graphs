    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-alternance-commerciale-sales-business-developer-paris-85516/1>,
        <https://www.arbeitnow.fr/jobs/companies/matera/alternance-commerciale-sales-business-developer-paris-85516> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b76370891042fdcf999ea3708a20017621fcf8a40eb2d66fa204d5570c9da27b" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
