    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-working-student-marketing-and-communications-frankfurt-am-main-hq-house-of-logistics-mobility-holm-186706/1> ;
