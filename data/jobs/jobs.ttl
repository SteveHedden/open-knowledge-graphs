    schema:jobLocationType "ON_SITE" ;
    schema:title "Werkstudent Online Marketing & PR (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/echo-poster-gmbh/werkstudent-online-marketing-pr-berlin-250435> .

