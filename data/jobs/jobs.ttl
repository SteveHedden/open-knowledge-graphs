<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-graduate-sales-development-representative-birmingham-37541> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-graduate-sales-development-representative-birmingham-37541/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/joblogic/graduate-sales-development-representative-birmingham-37541> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7401eb0145d05b0c2142dbb3e0284c1322cae2d48ec8726257ffdacc81a777c9" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
