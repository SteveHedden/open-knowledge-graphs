<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-account-executive-gtme-strategic-london-439045> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-account-executive-gtme-strategic-london-439045/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/clay-labs/account-executive-gtme-strategic-london-439045> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f9552986957debb25d72ea572eac0a28a2d49ebcebecd89a68afec5e2abc6c06" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
