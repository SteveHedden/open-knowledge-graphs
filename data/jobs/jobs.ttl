        <https://www.arbeitnow.co.uk/jobs/companies/mirakl/senior-account-manager-londres-236323> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "88b115570f2f362f8268292d451cd786a77d89d679e97f042788e3d90359dcf9" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
