    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-lead-engineer-b2b-saas-industrieplattform-leipzig-202498/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Lead Engineer (m/w/d) - B2B-SaaS & Industrieplattform" ;
