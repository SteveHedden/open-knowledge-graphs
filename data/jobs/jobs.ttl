        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-ai-growth-strategic-partnership-manager-paris-335886/1>,
        <https://www.arbeitnow.fr/jobs/companies/palo-it/ai-growth-strategic-partnership-manager-paris-335886> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6d3e8ca6208eee5036c334a457ecf9eed90a1c8224c3fcf66433dd391b1b0b28" ;
    kgjobs:classification "not_match" ;
