    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-customer-success-manager-high-touch-berlin-263903/1>,
        <https://www.arbeitnow.com/jobs/companies/voize/customer-success-manager-high-touch-berlin-263903> ;
