    schema:jobLocationType "ON_SITE" ;
    schema:title "Talent Acquisition Team Leader - Europe" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/sungrow-europe-welcome-traveler/talent-acquisition-team-leader-europe-germany-munich-58581> .

