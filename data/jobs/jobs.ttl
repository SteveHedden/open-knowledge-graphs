        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-vp-strategic-operations-uk-eu-london-401307/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/hims-and-hers/vp-strategic-operations-uk-eu-london-401307> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7aa127648a04de080e5399f08b5e6eec5295ac4a350c35c7fa616c62ad43f38d" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
