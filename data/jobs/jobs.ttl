    kgjobs:canonicalFingerprint "f83d2ae33ce2f3bdf5ae3980eef650f90d3212cd046d1fa4f8a2a4093475146c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-financial-planning-analysis-intern-bordeaux-450504/1> ;
