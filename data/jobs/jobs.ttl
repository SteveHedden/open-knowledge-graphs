    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-steuerberater-in-albstadt-auf-wunsch-mit-partnerperspektive-gesucht-mindestens-90000eur-149313/1>,
        <https://www.arbeitnow.com/jobs/companies/taxtalentede/steuerberater-in-albstadt-auf-wunsch-mit-partnerperspektive-gesucht-mindestens-90000eur-149313> ;
