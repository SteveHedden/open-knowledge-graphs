    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-business-director-f-h-cdi-paris-189934/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Business Director - F/H - CDI" ;
    schema:url <https://www.arbeitnow.fr/jobs/companies/wppmedia/business-director-f-h-cdi-paris-189934> .

