        <https://www.arbeitnow.co.uk/jobs/companies/conduct/backend-engineer-london-286984> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7999ed3620eeeac326643f86e7262921c7701c81f3796079050e3cdf95acd4ea" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
