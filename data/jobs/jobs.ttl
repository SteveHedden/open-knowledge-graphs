<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-staff-solutions-engineer-dach-188857> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
