<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-customer-engineer-pre-post-sales-london-205640> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-customer-engineer-pre-post-sales-london-205640/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/pendo/senior-customer-engineer-pre-post-sales-london-205640> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "bd56306f85fc51dfd3c6d33cb767c5fcb28831c46b00c556a3456461cd085b31" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
