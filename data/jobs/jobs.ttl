    kgjobs:canonicalFingerprint "69ad250814743140f12691d603b6e22e8cd1fad4f07fbeabd0720d764772aa7f" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
