<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-software-engineer-belfast-northern-ireland-257833> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-software-engineer-belfast-northern-ireland-257833/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/everquote/senior-software-engineer-belfast-northern-ireland-257833> ;
    kgjobs:active true ;
