<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-private-equity-partnerships-emea-london-174861> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
