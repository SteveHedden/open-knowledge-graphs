<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-videograf-content-producer-hamburg-124910> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-videograf-content-producer-hamburg-124910/1>,
        <https://www.arbeitnow.com/jobs/companies/skinbro-gmbh/videograf-content-producer-hamburg-124910> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7a825e95161041f3b8a8f5522f64f6d6a807e5c132a7f3d1945a3274fbd15d6e" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-videograf-content-producer-hamburg-124910/1> ;
    kgjobs:sourceRecordId "videograf-content-producer-hamburg-124910" ;
    schema:datePosted "2026-09-07"^^xsd:date ;
    schema:description "SKINBRO ist eine der am schnellsten wachsenden Männerpflege-Marken Deutschlands. Feste Duschseifen, Deos und Parfums – plastikfrei, made in Germany, mit Düften, die Männer wirklich wollen. Über 90.000 Kunden, in den letzten Monaten jeden Monat fast verdoppelt. Wir sitzen in Hamburg, sind ein kleines, schnelles Team und wachsen ohne Konzernstrukturen. Unser Wachstum kommt aus Creatives. Aktuell produzieren wir rund 300 Ads im Monat mit einem Shooting pro Woche. Mit dir wollen wir auf drei Shootings pro Woche und über 1.000 Assets im Monat. Spoiler: Wir suchen keinen klassischen Videografen und keinen Creative Director. Wir suchen die Person, die Ideen in die Realität bringt. Die Creative Strategie – Konzepte, Skripte, Angles, Briefings – kommt fertig vom Gründer. Du bekommst am Anfang der Woche deine Shooting-Pläne und ziehst sie von A bis Z durch. Um dich herum: externe Video-Editoren, ein Grafikdesigner, ein eingespielter Prozess. Das ist eine ausführende Rolle, keine konzeptionelle. Wenn du lieber selbst die Strategie machen willst, ist das nicht die richtige Stelle. Wenn du Bock hast, in einer Creative-Maschine zu arbeiten, die bereits funktioniert, und sie mit uns zu verdreifachen – dann schon. Aufgaben Du führst 2–3 Shootings pro Woche eigenständig durch – ohne dass der Gründer am Set stehen muss. Du organisierst alles drumherum: Location, Darsteller, UGC-Creator, Zeitplan, Equipment, Verpflegung. Du sourcst regelmäßig neue Gesichter für Straßeninterviews, Schauspieler-Spots und UGC. Du bedienst die Kamera selbst und lieferst sauberes, verwertbares Rohmaterial nach Briefing. Du legst das Material strukturiert ab und übergibst es mit klarem Briefing an unsere Editoren. Du gibst den Editoren fundiertes Feedback und schneidest bei Bedarf selbst. Du analysierst gemeinsam mit dem Gründer, welche Creatives performt haben und welche nicht – und nimmst die Learnings mit ins nächste Shooting. Qualifikation Du kannst Shootings komplett selbstständig durchführen – Planung, Dreh, Ablage. Du kannst editieren (Premiere, CapCut, DaVinci o. ä.) – gut genug, um Editoren präzise zu briefen, ihr Ergebnis zu bewerten und selbst Videos zu schneiden. Du hast Feingefühl am Set: Du empfängst Leute, machst sie locker, korrigierst taktvoll und sorgst dafür, dass alle gerne wiederkommen – auch bei Skripten, die etwas frecher sind. Du hast ein Gespür dafür, welche Person welche Aussage am glaubwürdigsten rüberbringt. Du arbeitest strukturiert nach Prozess und Checkliste und hast kein Problem damit, Content in hoher Frequenz zu produzieren, ohne dass die Qualität leidet. Du verstehst, was eine Performance-Ad von einem schönen Video unterscheidet – oder willst es schnell lernen. Du wohnst in Hamburg oder bist bereit, hierher zu ziehen. Benefits Direkte Zusammenarbeit mit dem Gründer-Team. Ads, die jeden Monat Millionen von Männern sehen – du siehst sofort, was dein Output bewirkt. Keine Konzernstrukturen, kurze Wege, schnelle Entscheidungen. Büro direkt in der Hamburger-Innenstadt. Find Jobs in Germany on Arbeitnow" ;
    schema:hiringOrganization kgjd:employer-skinbro-gmbh ;
    schema:identifier "arbeitnow-videograf-content-producer-hamburg-124910" ;
    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-videograf-content-producer-hamburg-124910/location> ;
    schema:jobLocationType "ON_SITE" ;
