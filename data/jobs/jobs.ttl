<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-software-engineer-windows-desktop-applications-dusseldorf-germany-350811> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
