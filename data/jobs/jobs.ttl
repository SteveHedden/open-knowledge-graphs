    kgjobs:canonicalFingerprint "efc40305168b0d48419ee2b3058d6fcc18b67a6666226883cf07d85f24cfd1b7" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
