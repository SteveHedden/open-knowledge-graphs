    schema:jobLocationType "ON_SITE" ;
    schema:title "Werkstudent (m/w/d) KI & Automatisierung Stuttgart" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/hws/werkstudent-ki-automatisierung-stuttgart-230363> .

