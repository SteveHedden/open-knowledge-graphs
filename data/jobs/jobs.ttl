    schema:url <https://www.arbeitnow.com/jobs/companies/capco/senior-business-analyst-wealth-management-advisory-platforms-398020> .

<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-business-travel-consultant-perk-uki-english-speaker-edinburgh-88985> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-business-travel-consultant-perk-uki-english-speaker-edinburgh-88985/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/perk/senior-business-travel-consultant-perk-uki-english-speaker-edinburgh-88985> ;
    kgjobs:active true ;
