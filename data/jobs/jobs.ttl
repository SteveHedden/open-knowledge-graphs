    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-werkstudent-im-bereich-innovation-new-business-startups-all-people-leipzig-472996/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Werkstudent im Bereich Innovation, New Business & Startups (all people)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/leipziger-foren-services-gmbh/werkstudent-im-bereich-innovation-new-business-startups-all-people-leipzig-472996> .

