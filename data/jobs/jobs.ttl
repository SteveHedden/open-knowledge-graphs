    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-photonics-characterisation-engineer-oxford-216753/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/salience-labs/photonics-characterisation-engineer-oxford-216753> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "4383a8e433fb48e058c9db1ee3b42753a19a068caa7f38c8c1b9b4f0013f715b" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
