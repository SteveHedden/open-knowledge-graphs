<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-werkstudent-ki-automatisierung-neumarkt-in-der-oberpfalz-23563> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-ki-automatisierung-neumarkt-in-der-oberpfalz-23563/1>,
        <https://www.arbeitnow.com/jobs/companies/modern-drive-technology-gmbh/werkstudent-ki-automatisierung-neumarkt-in-der-oberpfalz-23563> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "09911c685c087633750bd62b5df7ae21fd7fe4d5eecef16fb33d9327e2e5f878" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-ki-automatisierung-neumarkt-in-der-oberpfalz-23563/1> ;
    kgjobs:sourceRecordId "werkstudent-ki-automatisierung-neumarkt-in-der-oberpfalz-23563" ;
    schema:datePosted "2026-09-08"^^xsd:date ;
    schema:description "Prozesse verstehen. Lösungen bauen, die bei KMUs tatsächlich laufen. Warum es diese Stelle gibt Wir sind ein kleines Team in Neumarkt und entwickeln IoT-Cloud-Lösungen für Maschinen- und Fahrzeughersteller. Parallel bauen wir eine Automatisierungsplattform, mit der wir Prozesse automatisieren – für uns selbst und für unsere Kunden. Mit KI-Agenten, LLM-Anbindungen und der Integration bestehender Fachsysteme. Der Bedarf ist größer als das, was wir nebenbei erledigen können. Deshalb suchen wir jemanden, der genau daran arbeitet: bestehende Prozesse aufnehmen, verstehen wo es klemmt, und dann eine Lösung bauen, die läuft. Was wir nicht suchen: jemanden, der Konzepte schreibt, die niemand umsetzt. Und keine Forschungsprojekte. Unsere Lösungen müssen zu einem Mittelständler passen – also einfach genug, dass sie auch ohne dich weiterlaufen. Aufgaben Was du machst Prozesse aufnehmen. Du sprichst mit den Menschen, die einen Prozess täglich durchlaufen – bei uns oder beim Kunden. Du hältst fest, wie er heute wirklich läuft (nicht, wie er laut Handbuch laufen sollte), wo Zeit verloren geht und was am Ende besser sein soll. Konzipieren. Du entscheidest, welcher Teil sich automatisieren lässt, wo KI echten Mehrwert bringt und wo eine einfache Regel genügt. Du schätzt Aufwand und Nutzen ab und legst dem Prozessowner eine Empfehlung vor – keine Optionsliste. Umsetzen, hands-on. Du baust die Lösung selbst: KI-Agenten auf Basis von LLM-APIs, Automatisierungs-Workflows, Anbindung bestehender Systeme über REST-Schnittstellen und Webhooks, dazu die nötige Datenaufbereitung. Und ein Skript in Python oder JavaScript, wo Klicken nicht reicht. Review und Übergabe. Du gehst mit dem Prozessowner durch, ob die Lösung im Alltag hält. Du prüfst nach, dokumentierst so, dass eine andere Person daran weiterarbeiten kann, und übergibst sauber. Qualifikation Was du mitbringen musst Verhandlungssicheres Deutsch. Du führst Prozessgespräche mit Anwendern und Prozessownern, teils bei Kunden im Mittelstand. Das geht nicht auf Englisch. Verhandlungssicher heißt: du diskutierst frei, auch wenn es fachlich und sprachlich kompliziert wird. Mindestens ein Tag pro Woche vor Ort in Neumarkt in der Oberpfalz. Prozessaufnahme funktioniert im Gespräch, nicht im Ticketsystem. Die übrige Zeit arbeitest du flexibel und remote. Echte Begeisterung für KI und erste eigene Erfahrung damit. Kein Zertifikat, kein Studienschwerpunkt – aber du musst schon einmal selbst etwas mit KI gebaut haben. Ein Agent, ein LLM-Workflow, ein Chatbot auf eigenen Daten, ein Automatisierungsskript mit angebundenem Modell. Wir fragen im Gespräch danach, und zwar im Detail. Dazu: laufendes Studium – Wirtschaftsinformatik, Informatik, Wirtschaftsingenieurwesen, Technologie- oder Innovationsmanagement oder etwas Vergleichbares. Die Fachrichtung ist uns weniger wichtig als deine Arbeitsweise. Du hast eine Sache schon einmal zu Ende gebaut – nicht nur angefangen. Du kannst dich in einen fremden Prozess hineindenken und die richtigen Fragen stellen. Du schreibst so, dass andere es verstehen. Was wir gerne sehen, aber nicht erwarten Praxis mit LangChain, LangGraph oder vergleichbaren Agenten-Frameworks Erfahrung mit RAG, Vektordatenbanken oder Prompt Engineering über Spielerei hinaus Grundlagen in Python, JavaScript/TypeScript und SQL Arbeit mit KI-Coding-Tools wie Claude Code, GitHub Copilot oder Cursor Ausdrücklich kein Muss: n8n. Wir arbeiten damit, aber diesen Teil deckt eine Kollegin bereits ab. Wenn du es kennst, gut – wenn nicht, lernst du es hier in wenigen Tagen. Benefits Was du bekommst Echte Verantwortung für eigene Prozesse – vom ersten Gespräch bis zum Livegang. Keine Zuarbeit. Anleitung durch unser Senior-Team, aber viel Freiraum in der Umsetzung. Arbeit mit aktuellen KI- und Automatisierungswerkzeugen an produktiven Systemen, nicht an Sandkastenprojekten. Kleines Team, kurze Wege, Entscheidungen am selben Tag. 15–20 Stunden pro Woche im Semester, in den Semesterferien nach Absprache mehr. Schick uns deinen Lebenslauf und ein paar Sätze zu einer KI- oder Automatisierungslösung, die du selbst gebaut hast: Wie lief der Prozess vorher, was hast du gebaut, welches Modell oder Tool hast du eingesetzt und warum, was war danach besser? Wenn es dazu ein Repository oder eine kurze Demo gibt, umso besser. Find Jobs in Germany on Arbeitnow" ;
    schema:employmentType "Working student" ;
    schema:hiringOrganization kgjd:employer-modern-drive-technology-gmbh ;
    schema:identifier "arbeitnow-werkstudent-ki-automatisierung-neumarkt-in-der-oberpfalz-23563" ;
    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-werkstudent-ki-automatisierung-neumarkt-in-der-oberpfalz-23563/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Werkstudent AI Engineering (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/modern-drive-technology-gmbh/werkstudent-ki-automatisierung-neumarkt-in-der-oberpfalz-23563> .

