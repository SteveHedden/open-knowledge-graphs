<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-centrale-lyon-enise-post-doctorat-modelisation-et-optimisation-de-la-spheroidisation-de-poudres-metalliques-par-plasma-rf-st-etienne-356835> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-centrale-lyon-enise-post-doctorat-modelisation-et-optimisation-de-la-spheroidisation-de-poudres-metalliques-par-plasma-rf-st-etienne-356835/1>,
        <https://www.arbeitnow.fr/jobs/companies/centrale-lyon/centrale-lyon-enise-post-doctorat-modelisation-et-optimisation-de-la-spheroidisation-de-poudres-metalliques-par-plasma-rf-st-etienne-356835> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "d3c0de51afb4822764da3fa43acdf264eacd3cf49e426aabc3941c385beada7e" ;
    kgjobs:classification "not_match" ;
