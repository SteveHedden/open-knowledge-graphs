    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-patent-engineer-life-sciences-london-183606/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/ankar/patent-engineer-life-sciences-london-183606> ;
