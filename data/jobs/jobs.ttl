    schema:jobLocationType "ON_SITE" ;
    schema:title "Senior Consultant (w/m/d) Policy Monitoring & Reporting im Bereich Forschung und Innovation" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/technopolis-group/senior-consultant-policy-monitoring-reporting-im-bereich-forschung-und-innovation-berlin-148257> .

