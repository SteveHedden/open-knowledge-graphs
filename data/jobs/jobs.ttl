<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-integrated-marketing-strategy-planning-manager-paris-58978> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-integrated-marketing-strategy-planning-manager-paris-58978/1>,
        <https://www.arbeitnow.fr/jobs/companies/deliveroo/senior-integrated-marketing-strategy-planning-manager-paris-58978> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b6adf99b29a2a5fd799b95db8bc269ef6122ef2be3e2096a7e27242b66fb7b41" ;
