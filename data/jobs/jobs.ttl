    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-manager-london-359994/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/faculty/senior-manager-london-359994> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "28bd4417ec61598cbfb86bd73f84f44ce954359104c775068fd81167bb83bf7d" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
