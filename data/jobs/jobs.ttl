        <https://www.arbeitnow.co.uk/jobs/companies/xyz-reality/systems-engineer-reading-188179> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c3a4dc022c788b418cfcd71d6546b214ce812206f3b0edcd9323d9c0c5d11cf5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
