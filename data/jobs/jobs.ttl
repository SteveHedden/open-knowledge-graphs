<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-solution-operations-manager-value-realization-paris-254054> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
