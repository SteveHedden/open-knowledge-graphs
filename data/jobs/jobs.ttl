<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-account-executive-london-470143> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-account-executive-london-470143/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/scarlet/account-executive-london-470143> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "76d5565f6cfa320fdcf1dde8d6cca01299eb10a4554542f20457b61d312782d5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
