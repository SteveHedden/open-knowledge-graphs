    schema:jobLocationType "ON_SITE" ;
    schema:title "Projektmanager / Projektentwickler (m/w/d) PV / Green Energy" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/feld-energy/projektmanager-projektentwickler-pv-green-energy-office-munchen-68557> .

