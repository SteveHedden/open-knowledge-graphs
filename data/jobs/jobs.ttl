<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-influencer-marketing-manager-vollzeit-100-remote-dusseldorf-165611> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
