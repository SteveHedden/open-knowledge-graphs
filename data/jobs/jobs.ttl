<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-strategist-agent-development-flemish-speaking-london-363365> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-strategist-agent-development-flemish-speaking-london-363365/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/sierra/strategist-agent-development-flemish-speaking-london-363365> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f082b25f5dd132c740138504b4f97acdd599e05d65db8e611297515cdce71608" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
