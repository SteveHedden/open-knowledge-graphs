    prov:wasDerivedFrom <https://himalayas.app/companies/albert-invent/jobs/digital-marketing-manager-web-ai-search-5322516353>,
        <https://openknowledgegraphs.com/jobs/live/occurrence/himalayas-6a7c14219d96cc4e/1> ;
