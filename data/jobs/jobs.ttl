<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-head-of-brand-marketing-london-288916> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-head-of-brand-marketing-london-288916/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/faculty/head-of-brand-marketing-london-288916> ;
