    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-tech-lead-ia-h-f-paris-370675/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:mentions <https://openknowledgegraphs.com/resource/unified-code-for-units-of-measure/> ;
    schema:title "TECH LEAD IA H/F" ;
    schema:url <https://www.arbeitnow.fr/jobs/companies/thiga/tech-lead-ia-h-f-paris-370675> .

