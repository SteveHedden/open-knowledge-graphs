    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-junior-art-director-berlin-schlesische-strasse-26-330607/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "(Junior) Art Director (w/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/hirschen-group-gmbh/junior-art-director-berlin-schlesische-strasse-26-330607> .

