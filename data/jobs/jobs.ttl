<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-strategic-finance-manager-london-105960> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-strategic-finance-manager-london-105960/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/the-flex/strategic-finance-manager-london-105960> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "9c90558222f23ad261dcaefd4aa7f13e35dfd6a2fad579a1533f69790b9e72f1" ;
