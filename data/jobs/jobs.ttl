    schema:jobLocationType "ON_SITE" ;
    schema:title "Influencer Marketing Manager (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/efly-marketplace-services-gmbh/influencer-marketing-manager-stuttgart-233802> .

