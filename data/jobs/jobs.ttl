    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b9911eed7568d0d778347f9cd4ed9de54cb64c6fbc9be4bb47b2778e9b0886b0" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
