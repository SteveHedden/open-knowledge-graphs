        <https://www.arbeitnow.com/jobs/companies/vivid/founding-sdr-dach-market-berlin-242485> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "5ec0316b6415277506a5c92291eadc046fc7957af267eb8a8b3a97466a04aa3d" ;
