<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-on-holiday-support-agent-145515> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-on-holiday-support-agent-145515/1>,
        <https://www.arbeitnow.fr/jobs/companies/loveholidays/remote-on-holiday-support-agent-145515> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "580054c35a58e062d00c587ea3fec8af7f6ee4697210633ea330ec4cb1a36b56" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
