    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-werkstudent-ki-automatisierung-stuttgart-168851/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Werkstudent (m/w/d) KI & Automatisierung Stuttgart" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/hws/werkstudent-ki-automatisierung-stuttgart-168851> .

