    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-claims-handler-gadget-with-apa-cip-qualification-uk-irl-339536/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/claimsorted/remote-claims-handler-gadget-with-apa-cip-qualification-uk-irl-339536> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7707d571d866ed8c73996429d544d0f6f1c1e8718e8356d5e71d1b17bc5fca06" ;
    kgjobs:classification "not_match" ;
