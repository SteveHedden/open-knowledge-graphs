    prov:generatedAtTime "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-data-governance-lead-amsterdam-nld-london-49939/1>,
