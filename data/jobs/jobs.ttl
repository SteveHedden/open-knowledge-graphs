        <https://www.arbeitnow.com/jobs/companies/yepoda/brand-experience-manager-berlin-199979> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c49d3b710695c028d44b0f83aa532582c55f2ad4666652f1bd321259cf6ff4ac" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
