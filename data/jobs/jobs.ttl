    schema:jobLocationType "ON_SITE" ;
    schema:title "Working Student (all genders) – Robust Feed-Forward 3D Reconstruction for Dynamic Scene" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/xitaso/working-student-all-genders-robust-feed-forward-3d-reconstruction-for-dynamic-scene-augsburg-179872> .

