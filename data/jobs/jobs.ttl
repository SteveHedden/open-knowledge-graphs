    schema:jobLocationType "ON_SITE" ;
    schema:title "Werkstudent (m/w/d) AI Engineering" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/suxxeed-sales-for-your-success-gmbh/werkstudent-ai-engineering-cologne-5088> .

