<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-engine-cycle-engineer-parsdorf-bavaria-284793> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-engine-cycle-engineer-parsdorf-bavaria-284793/1>,
        <https://www.arbeitnow.com/jobs/companies/isaraerospace/senior-engine-cycle-engineer-parsdorf-bavaria-284793> ;
    kgjobs:active true ;
