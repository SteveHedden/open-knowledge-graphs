        <https://www.arbeitnow.fr/jobs/companies/mistralai/solution-operations-manager-value-realization-paris-254054> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3824be3838e65d5899ef09cf620ab162326793896fbd2c8f6aba05af1364d2f5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
