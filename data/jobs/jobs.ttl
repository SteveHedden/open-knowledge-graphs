<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-working-student-marketing-and-communications-frankfurt-am-main-hq-house-of-logistics-mobility-holm-186706> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-working-student-marketing-and-communications-frankfurt-am-main-hq-house-of-logistics-mobility-holm-186706/1>,
        <https://www.arbeitnow.com/jobs/companies/rail-flow-gmbh/working-student-marketing-and-communications-frankfurt-am-main-hq-house-of-logistics-mobility-holm-186706> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b60cba614aebf9c009c344e4d2d58aefd66c875b45b45984efb7e62924c3c690" ;
    kgjobs:classification "not_match" ;
