    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-om-asset-manager-europe-uk-london-293364/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/sungrow-emea/senior-om-asset-manager-europe-uk-london-293364> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "8d8ef9f907ebea9857e8bc0a43919501b06c05b3a0addd5f2eca603f7f43a820" ;
