        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-mixed-signal-ic-design-engineer-paris-235018/1>,
        <https://www.arbeitnow.fr/jobs/companies/arago/mixed-signal-ic-design-engineer-paris-235018> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "acfd76659cf6cf1dd43734ca18eac32fa02e784690544b27d04ac46e35c6761a" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
