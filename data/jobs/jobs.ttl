<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-software-engineering-intern-paris-74277> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-software-engineering-intern-paris-74277/1>,
        <https://www.arbeitnow.fr/jobs/companies/datadog/software-engineering-intern-paris-74277> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "33719eb61d02acf781a30080603bebdf97c541a272885155278d690fe1884003" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
