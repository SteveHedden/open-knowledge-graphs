        <https://www.arbeitnow.com/jobs/companies/passionfroot/creator-acquisition-manager-berlin-397198> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0b9c97ed849a6130ad5af4ef76367327fcb3a16dc841831b5739a393c20c2021" ;
    kgjobs:classification "not_match" ;
