    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-teamleiter-fahrzeugbewertung-grossraum-hamburg-lubeck-158975/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Teamleiter Fahrzeugbewertung - Großraum Hamburg (m/w/d)" ;
