    schema:jobLocationType "ON_SITE" ;
    schema:title "(Senior) Manager Business Development (all genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/sunday-natural/senior-manager-business-development-all-genders-berlin-258413> .

