        <https://www.arbeitnow.com/jobs/companies/gropyus/senior-process-planner-berlin-berlin-416919> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6371091169e0ce18f6cd2165719989d1a4feb79ca6807ebeab7c45029a72c838" ;
