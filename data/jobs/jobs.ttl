    schema:jobLocationType "ON_SITE" ;
    schema:title "STAGE - Assistant Chef de Produit Offre Poker (H/F)" ;
    schema:url <https://www.arbeitnow.fr/jobs/companies/winamax/stage-assistant-chef-de-produit-offre-poker-h-f-paris-380598> .

