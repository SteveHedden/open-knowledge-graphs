    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Influencer Marketing Manager (m/w/d), Vollzeit, 100% Remote" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/meluya-gmbh/influencer-marketing-manager-vollzeit-100-remote-dusseldorf-165611> .

