<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-forward-deployed-engineer-london-33491> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-forward-deployed-engineer-london-33491/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/mondaycom/forward-deployed-engineer-london-33491> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "94586370bb59859486bb1c386485a15909efde323fef47568a5e8107992cab01" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-forward-deployed-engineer-london-33491/1> ;
    kgjobs:sourceRecordId "forward-deployed-engineer-london-33491" ;
    schema:datePosted "2026-09-09"^^xsd:date ;
    schema:description "As a Forward Deployed Engineer in the customer organisation, you are the technical spearhead of monday.com's AI transformation motion for our most strategic customers. You will carry a portfolio of 1 to 2 strategic accounts, deeply embedded with C-level and technical teams to architect, build, and ship AI solutions in production, and you will be accountable for the business outcomes those engagements promised, not just the build. This is part of a growing motion, and you will be joining a team that’s already working on active deployments. Please note this is a hybrid position of 3 days/week in our London office. About the Role Enterprises don't struggle to access AI capability; they struggle to deploy it. Your job is closing that gap for a small portfolio of monday.com's highest-value customers. You will advise executives on AI-driven operational change, design and ship the systems that make it real, and feed what you learn back into the product with evidence, not anecdotes. You will work with: monday AI agents, MCP-based integrations into customer systems, vibe apps, and production workflows. You will take these from discovery through architecture, build, rollout, and measurable adoption. This is an autonomous, high-visibility role that shapes both customer outcomes and the future of forward-deployed engineering at monday.com. What You'll Do Strategic transformation. Embed with C-level stakeholders across your accounts to architect end-to-end AI solutions and scalable workflows that solve complex, mission-critical business pains. You own the narrative from pilot to full production rollout. Outcome ownership. Your success metric is the business result the engagement committed to: adoption, workflow throughput, measurable ROI. You define the success criteria with the customer up front and you own getting there. Build and ship. Design sophisticated platform configurations, build monday agents and vibe apps, wire MCP integrations into customer systems, and prototype custom scripts where the platform ends. Your leverage is architecture and judgment; your credibility is that you can build it yourself. Eval-driven product feedback. Instrument your deployments, run evals against real customer workflows, and translate what you find into PRDs and roadmap input that changes what we build. You are a sensor for the product org, with data behind every claim. Cross-functional leadership. Partner with Sales and CS as the technical authority on account strategy. Productize what you learn: patterns, agents, and assets from one account become reusable machinery for the whole motion. What we promise This role has been built with a direct line into the product roadmap, a mandate to productize rather than repeat, and outcome-based success criteria agreed before the build starts. What You Bring 5+ years building applications from scratch using TypeScript/Node.js/React, with full-stack depth Experience leading hands-on projects end-to-end in a production environment, preferably client-facing Background in Solution Architecture or Software Engineering with a strong grasp of AI/LLM systems: agent architectures, MCP or comparable tool-use protocols, evals, and prompt-to-production workflows Experience navigating C-suite relationships and influencing executive decisions in ambiguous environments Track record of turning one-off delivery work into reusable assets, product requirements, or repeatable playbooks Entrepreneurial, fast-moving, and focused on long-term impact over immediate fixes Find Jobs in United Kingdom on Arbeitnow" ;
    schema:employmentType "Full Time" ;
    schema:hiringOrganization kgjd:employer-monday-com ;
    schema:identifier "arbeitnow-forward-deployed-engineer-london-33491" ;
    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-forward-deployed-engineer-london-33491/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Forward Deployed Engineer" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/mondaycom/forward-deployed-engineer-london-33491> .

