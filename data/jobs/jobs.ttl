    schema:jobLocationType "ON_SITE" ;
    schema:title "Office Manager – Empfang & Administration (all genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/sunday-natural/office-manager-empfang-administration-all-genders-berlin-415339> .

