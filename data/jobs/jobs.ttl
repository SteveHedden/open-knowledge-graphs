<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-software-engineer-9th-arrondissement-of-paris-75009-paris-34859> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
