    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-research-associate-london-411793/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/more-in-common/senior-research-associate-london-411793> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e57fe6a48013b40e6c627583b10586e9a92f85246cdaddd100a7455b55529bfa" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
