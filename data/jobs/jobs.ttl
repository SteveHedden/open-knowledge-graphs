    schema:jobLocationType "ON_SITE" ;
    schema:title "Praktikant*in Brand & Product Marketing (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/amperecloud-gmbh/praktikantin-brand-product-marketing-berlin-364439> .

