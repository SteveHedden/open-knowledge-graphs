    kgjobs:active true ;
    kgjobs:canonicalFingerprint "9fe1726b32119d5cddb0c49061cf61da76e4b6d333aa9299cdc0f0d67860cc4a" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
