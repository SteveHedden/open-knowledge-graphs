    prov:generatedAtTime "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-sr-agent-architect-germany-72194/1>,
