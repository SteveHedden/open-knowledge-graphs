<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-product-manager-full-remote-europe-germany-35518> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
