<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-process-planner-berlin-berlin-416919> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
