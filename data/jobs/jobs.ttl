        <https://www.arbeitnow.fr/jobs/companies/brevo/ai-native-product-engineer-paris-france-332101> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a343dc5602c23fd727d0d9168b30307bd22b314b8a73df5616b725229b69dd7a" ;
