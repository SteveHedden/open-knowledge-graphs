        <https://www.arbeitnow.co.uk/jobs/companies/trainline/head-of-product-b2b-london-45838> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "40eefda7c97385223d35e75bc903e88d942b46666c3de6bd6ef18764b856aa61" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
