<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-lead-business-analyst-process-automation-belfast-remote-309459> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-lead-business-analyst-process-automation-belfast-remote-309459/1>,
