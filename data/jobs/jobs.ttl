    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-category-management-werkstudent-dusseldorf-north-rhine-westphalia-168609/1>,
        <https://www.arbeitnow.com/jobs/companies/teampicnic/category-management-werkstudent-dusseldorf-north-rhine-westphalia-168609> ;
    kgjobs:active true ;
