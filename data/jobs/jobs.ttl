    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e86f41df7d762e54a8c4a1a1079dc5a7cdc58f62b90231dd689109d4a3907dd6" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
