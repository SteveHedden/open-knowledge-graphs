    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-junior-net-engineer-london-286757/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/trainline/junior-net-engineer-london-286757> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "30cd806bbedd7bf560ed1efa9f1973953db3324c5bbdbc3df541ef828d4a15a7" ;
    kgjobs:classification "not_match" ;
