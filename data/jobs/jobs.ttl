<https://openknowledgegraphs.com/jobs/live/job/firstparty%3Afirst-party-amazon%3A10461324> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/first-party-amazon> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/firstparty%3Afirst-party-amazon%3A10461324/1>,
        <https://www.amazon.jobs/en/jobs/10461324/senior-delivery-consultant-data-professional-services-awsi-healthcare-and-life-sciences> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "fca386ea2ea659bf0dbdb7a8fbd5b96773fc3e15f5c083859c9ce4cbb81e01a0" ;
    kgjobs:classification "qualified" ;
