    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-hotelfachfrau-mann-reservation-agent-front-office-manager-vorstetten-20840/1>,
        <https://www.arbeitnow.com/jobs/companies/homery-living-gmbh/hotelfachfrau-mann-reservation-agent-front-office-manager-vorstetten-20840> ;
