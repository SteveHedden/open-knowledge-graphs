        <https://www.arbeitnow.co.uk/jobs/companies/docker/senior-security-engineer-offensive-security-england-36824> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "00c2812bc4dd6e787bb8b5ca35b7153ccc6a072b444e2f6fcf2f0ca7eb304d8c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
