<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-solutions-architect-customerlake-paris-375154> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-solutions-architect-customerlake-paris-375154/1>,
        <https://www.arbeitnow.fr/jobs/companies/databricks/solutions-architect-customerlake-paris-375154> ;
    kgjobs:active true ;
