<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-collection-merchandiser-shoes-berlin-435353> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-collection-merchandiser-shoes-berlin-435353/1>,
        <https://www.arbeitnow.com/jobs/companies/aeyde/senior-collection-merchandiser-shoes-berlin-435353> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "114c83cc5a46bb323c9e1582f7bb1aaf42604f679a25d2b65cedc4f72398eb57" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
