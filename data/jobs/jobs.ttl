        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-enterprise-account-executive-auth0-london-136111/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/okta/enterprise-account-executive-auth0-london-136111> ;
