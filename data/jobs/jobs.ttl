    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-business-operations-manager-product-data-insights-reporting-manchester-403733/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/anaplan/business-operations-manager-product-data-insights-reporting-manchester-403733> ;
