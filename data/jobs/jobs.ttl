        <https://www.arbeitnow.fr/jobs/companies/aircall/product-manager-intern-paris-office-335821> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e3dac45114be56cf15e993ebf503f1439900f57c25477e526e1bd6781270edf8" ;
