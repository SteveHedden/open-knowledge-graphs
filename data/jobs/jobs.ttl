    schema:jobLocationType "ON_SITE" ;
    schema:title "Senior Infrastructure Software Engineer" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/lightningai/senior-infrastructure-software-engineer-london-187242> .

