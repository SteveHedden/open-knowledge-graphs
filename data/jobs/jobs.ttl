<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-recruiting-coordinator-fixed-term-contract-london-199173> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-recruiting-coordinator-fixed-term-contract-london-199173/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/anthropic/senior-recruiting-coordinator-fixed-term-contract-london-199173> ;
