    kgjobs:active true ;
    kgjobs:canonicalFingerprint "bec97b6ff1a9af2845ef8a9d62f097a11cd6c06dd1394bd3e2e85fac4ce554d7" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
