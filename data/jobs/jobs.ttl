    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-talent-partner-london-261528/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/seccl/talent-partner-london-261528> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b5ae6854624576c773bbc250962aac0ae8853e243a5c44b0cba96bdf2649954e" ;
