        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-product-owner-all-genders-management-suite-tribe-augsburg-488192/1>,
        <https://www.arbeitnow.com/jobs/companies/baramundi-software-ag/product-owner-all-genders-management-suite-tribe-augsburg-488192> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "5b9d560a94c22e3efd2d4e91ff29b0cbdcd580591cbcff41ab95ebfaca4d1141" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
