        <https://www.arbeitnow.com/jobs/companies/ucmagency/technical-product-manager-berlin-217600> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e82bfeeac5af7fe685a963d25c534e35a6ba343f67abae36a7363ad2293d15c5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
