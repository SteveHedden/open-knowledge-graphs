    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-head-of-data-paris-485027/1>,
        <https://www.arbeitnow.fr/jobs/companies/luo/head-of-data-paris-485027> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "37db4caba5030d9e73ddd6ec78dbdb7c995a47ef13ffe43064993931f4070334" ;
    kgjobs:classification "not_match" ;
