    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-product-manager-hamburg-106621/1>,
        <https://www.arbeitnow.com/jobs/companies/adjoe/product-manager-hamburg-106621> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "064b33e1b31e6c72aed068aa5bc3632461c3253876c5a11f2bcd9319c1f2c754" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
