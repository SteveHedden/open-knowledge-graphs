    schema:jobLocationType "ON_SITE" ;
    schema:title "Global Talent Acquisition Partner, GTM (all genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/distribusion-technologies/global-talent-acquisition-partner-gtm-all-genders-berlin-385736> .

