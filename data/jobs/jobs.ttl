<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-regional-account-manager-public-sector-germany-282257> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-regional-account-manager-public-sector-germany-282257/1>,
        <https://www.arbeitnow.com/jobs/companies/magnet-forensics/regional-account-manager-public-sector-germany-282257> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b30f26368c951631e75e842543038462bedc51362d8062f67bd9aa929b5f7120" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
