    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-talent-acquisition-hamburg-hamburg-116018/1>,
        <https://www.arbeitnow.com/jobs/companies/teampicnic/werkstudent-talent-acquisition-hamburg-hamburg-116018> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "ccc8130068ea3ea96a33683cb2daae74b67f34fa745839ff0841fb66fa931a49" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
