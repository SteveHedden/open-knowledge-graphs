<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-head-of-b2b-energy-f-h-senior-manager-paris-112873> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-head-of-b2b-energy-f-h-senior-manager-paris-112873/1>,
        <https://www.arbeitnow.fr/jobs/companies/wundermanthompson/head-of-b2b-energy-f-h-senior-manager-paris-112873> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "125a1fa564c9fc13b982858646905f4318d55e9170c5d6cd7d92158e562e1626" ;
    kgjobs:classification "not_match" ;
