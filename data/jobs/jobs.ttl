    kgjobs:canonicalFingerprint "8587547bcf9e8b602d6b91b50942257254e84f77831ac2972e89969516129263" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
