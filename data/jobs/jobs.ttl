<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-graduate-ai-and-secure-technologies-engineer-2026-start-258690> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-graduate-ai-and-secure-technologies-engineer-2026-start-258690/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/cambridgeconsultantslimited/graduate-ai-and-secure-technologies-engineer-2026-start-258690> ;
    kgjobs:active true ;
