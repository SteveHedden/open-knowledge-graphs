    schema:jobLocationType "ON_SITE" ;
    schema:title "Backend Engineering Team Lead" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/netcraft/backend-engineering-team-lead-london-manchester-271704> .

