<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-product-manager-berlin-273353> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-product-manager-berlin-273353/1>,
        <https://www.arbeitnow.com/jobs/companies/caronsale/product-manager-berlin-273353> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "9f6d93c23fdd3d714a0ec3853e12e3226847fdbf15bb6de18619dfdc7d244725" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
