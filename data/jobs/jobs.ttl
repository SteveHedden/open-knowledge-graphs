    prov:generatedAtTime "2026-09-07T07:54:08+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://accenture.wd103.myworkdayjobs.com/AccentureCareers/job/Singapore/LLM-Full-Stack-Engineer-Associate-Director_14210568>,
        <https://openknowledgegraphs.com/jobs/live/occurrence/firstparty%3Afirst-party-accenture%3A14210568/1> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "66bd8c05144e5dbeffdc4ae64c09abd0bf01d91569b0d0b088c2902d3df46fe1" ;
    kgjobs:classification "qualified" ;
    kgjobs:firstSeenAt "2026-08-31T19:51:41+00:00"^^xsd:dateTime ;
