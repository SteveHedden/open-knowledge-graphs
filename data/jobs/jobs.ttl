    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-platform-engineer-foundations-london-390027/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/chainalysis/senior-platform-engineer-foundations-london-390027> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "03d67b6c0ac5ad55c94cb8b9a18b1f4b1c0c1cd1686cc26d678d6c95c9f1721d" ;
