<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-comercial-de-software-b2b-ia-y-transformacion-digital-hybrid-436505> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-comercial-de-software-b2b-ia-y-transformacion-digital-hybrid-436505/1>,
        <https://www.arbeitnow.fr/jobs/companies/zvoove/comercial-de-software-b2b-ia-y-transformacion-digital-hybrid-436505> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "85caaf1d8def8f38003ac00fa67ee0e82579caaeb773304f71b1593774fff670" ;
