    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-senior-salesforce-developer-445190/1>,
        <https://www.arbeitnow.com/jobs/companies/auxmoney-gmbh/remote-senior-salesforce-developer-445190> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "583bb0d5deaac5f84e9e17b7a45f3f6859433c1c25c662d0c8dcd446ef49cb17" ;
