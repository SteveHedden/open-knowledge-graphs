<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-principal-thermo-mechanical-engineer-paris-grenoble-205233> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-principal-thermo-mechanical-engineer-paris-grenoble-205233/1>,
        <https://www.arbeitnow.fr/jobs/companies/vinci4d/principal-thermo-mechanical-engineer-paris-grenoble-205233> ;
