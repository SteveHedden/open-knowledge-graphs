    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-solutions-consultant-352815/1>,
        <https://www.arbeitnow.fr/jobs/companies/rillet/remote-solutions-consultant-352815> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "5d5678e437e972f60aa9983b3aca10337e887cb1d42c99b26ad981215f5ddf44" ;
    kgjobs:classification "not_match" ;
