<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-inside-enterprise-account-executive-france-212506> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-inside-enterprise-account-executive-france-212506/1>,
        <https://www.arbeitnow.fr/jobs/companies/jamf/inside-enterprise-account-executive-france-212506> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "78082b3ef963c5c7881210dcba355adac7a22a6dae3ca8fdfb8b0bbb39e393eb" ;
    kgjobs:classification "not_match" ;
