    schema:jobLocationType "ON_SITE" ;
    schema:title "Head of Engineering (m/f/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/ecoplanet-green-operations-gmbh/head-of-engineering-munchen-71888> .

