    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudentin-innovation-management-berlin-325194/1>,
        <https://www.arbeitnow.com/jobs/companies/puschwahlig-workplace-law/werkstudentin-innovation-management-berlin-325194> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "4322eb5632707916ef83d5fe48bc6f8e1109de52c80171d8e82ff8979ce1dbcf" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
