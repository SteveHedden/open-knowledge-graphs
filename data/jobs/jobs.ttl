<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-solution-architect-germany-munich-498114> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-10T07:50:52+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-solution-architect-germany-munich-498114/1>,
        <https://www.arbeitnow.com/jobs/companies/veeamsoftware/senior-solution-architect-germany-munich-498114> ;
