<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-commercial-analytics-projects-mid-level-dusseldorf-north-rhine-westphalia-246524> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-commercial-analytics-projects-mid-level-dusseldorf-north-rhine-westphalia-246524/1>,
        <https://www.arbeitnow.com/jobs/companies/teampicnic/commercial-analytics-projects-mid-level-dusseldorf-north-rhine-westphalia-246524> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "ea6c6a98950f542aadb5b274a8264aa12b1222b4019f06265b356d6365a7781a" ;
    kgjobs:classification "not_match" ;
