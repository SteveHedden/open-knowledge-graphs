<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-freelance-senior-product-manager-product-consultant-abrechnung-erp-remote-berlin-489009> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-freelance-senior-product-manager-product-consultant-abrechnung-erp-remote-berlin-489009/1>,
        <https://www.arbeitnow.com/jobs/companies/arsipa-gmbh/freelance-senior-product-manager-product-consultant-abrechnung-erp-remote-berlin-489009> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "17e93fd67025cf9b44ed264bc1ec0be7d44b08925bfce0cdfde55eb48ef1d9c4" ;
    kgjobs:classification "not_match" ;
