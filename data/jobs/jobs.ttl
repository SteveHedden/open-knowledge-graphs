    schema:mentions <https://openknowledgegraphs.com/software/orientdb/> ;
    schema:title "Managing Principal – Capital Markets" ;
    schema:url <https://www.arbeitnow.fr/jobs/companies/capco/managing-principal-capital-markets-424898> .

