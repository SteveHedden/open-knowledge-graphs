    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-paris-account-executive-recruitment-day-paris-france-208802/1>,
        <https://www.arbeitnow.fr/jobs/companies/alan/paris-account-executive-recruitment-day-paris-france-208802> ;
