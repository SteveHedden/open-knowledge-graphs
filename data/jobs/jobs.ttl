    prov:generatedAtTime "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-field-sales-training-executive-cdd-sephora-france-paris-317554/1>,
        <https://www.arbeitnow.fr/jobs/companies/yepoda/field-sales-training-executive-cdd-sephora-france-paris-317554> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "9dd1e3e6c11180539201b42474105984e04376b4d7d681dda73b25f7dc758f4d" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-12T07:40:16+00:00"^^xsd:dateTime ;
