<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-data-consultant-h-f-cdi-paris-9th-arrondissement-of-paris-75009-paris-286851> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
