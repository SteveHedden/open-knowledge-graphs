<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-consultant-policy-monitoring-reporting-im-bereich-forschung-und-innovation-berlin-148257> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
