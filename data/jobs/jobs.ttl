    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Product Manager AI Search (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/moebel-de/remote-product-manager-ai-search-hamburg-292991> .

