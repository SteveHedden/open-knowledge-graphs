    schema:jobLocationType "ON_SITE" ;
    schema:title "(Senior) Consultant* - Meldewesen / Regulatory Reporting" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/capco/senior-consultant-meldewesen-regulatory-reporting-355484> .

