    schema:title "Werkstudent (m/w/d) im Unternehmensmarketing" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/wvm-immobilien-projektentwicklung-gmbh/werkstudent-im-unternehmensmarketing-wvm-koln-144640> .

