<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-site-reliability-engineer-sre-kubernetes-hybrid-cloud-berlin-104112> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-site-reliability-engineer-sre-kubernetes-hybrid-cloud-berlin-104112/1>,
