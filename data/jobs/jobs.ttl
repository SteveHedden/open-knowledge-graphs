    schema:jobLocationType "ON_SITE" ;
    schema:title "Senior Director, Legal & Compliance, OUS Regions" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/corcepttherapeutics/senior-director-legal-compliance-ous-regions-munich-bavaria-451028> .

