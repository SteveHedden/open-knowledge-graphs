    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-technical-adoption-architect-emea-implementation-consultant-london-351028/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/ironclad/technical-adoption-architect-emea-implementation-consultant-london-351028> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a375b0a25e014e760a328ec8cf942235f377d1a3dbf768a8cc675e28d2ea001c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
