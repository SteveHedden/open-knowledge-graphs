<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-working-student-accounting-finance-munich-hybrid-211489> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-working-student-accounting-finance-munich-hybrid-211489/1>,
        <https://www.arbeitnow.com/jobs/companies/twaice/working-student-accounting-finance-munich-hybrid-211489> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "302ff01a3c1010176125c350a7a813a660219c81dfc5c6883450acf44a8644d6" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
