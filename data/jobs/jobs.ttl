    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a3e120e9a913e97f6f2cdf7bd244ec10f28e3c74b0265068bb02112823a3b297" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-11T07:46:17+00:00"^^xsd:dateTime ;
