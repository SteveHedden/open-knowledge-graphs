<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-field-marketing-manager-london-149510> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
