<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-platform-engineer-london-95885> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-platform-engineer-london-95885/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/seccl/platform-engineer-london-95885> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "2368e3ae74063cd4359fab15d66e1b8a8490206bb2f302608b1bd80cbe643322" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-08T07:48:20+00:00"^^xsd:dateTime ;
