    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-technical-program-manager-science-operations-paris-435944/1>,
        <https://www.arbeitnow.fr/jobs/companies/mistralai/technical-program-manager-science-operations-paris-435944> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "15bd11245aba9aab2f529cbb26edc1b43dbb1ab0926eb404f4eabe00a678658b" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
