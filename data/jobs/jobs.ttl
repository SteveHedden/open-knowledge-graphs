<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-senior-product-performance-analyst-cologne-163841> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-senior-product-performance-analyst-cologne-163841/1>,
        <https://www.arbeitnow.com/jobs/companies/trusted-shops-se-de/remote-senior-product-performance-analyst-cologne-163841> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "9e5b67a24a7404163cf85cf5c7c4b78de03c871fcc468d1831f5254b7c24006a" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
