    prov:generatedAtTime "2026-09-14T08:31:40+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-marketing-social-media-manager-battlekart-halle-leipzig-halle-saale-38125/1>,
        <https://www.arbeitnow.com/jobs/companies/battlekart-halle-leipzig-gmbh/marketing-social-media-manager-battlekart-halle-leipzig-halle-saale-38125> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6d9e649bfb48e0225f97a4f4a9d936fe58d34f9ec04e6b684d54e993222e99be" ;
    kgjobs:classification "not_match" ;
