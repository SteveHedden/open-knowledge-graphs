        <https://www.arbeitnow.co.uk/jobs/companies/roku/senior-machine-learning-engineer-search-recommendations-cambridge-381724> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "eee4d1eb29a82665343e0261cbde251ffa146ad331bc19f0a97046b486fece82" ;
