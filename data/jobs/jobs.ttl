    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-full-stack-developer-typescript-nextjs-berlin-101785/1>,
        <https://www.arbeitnow.com/jobs/companies/yannickdigital-gmbh/senior-full-stack-developer-typescript-nextjs-berlin-101785> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "08ce9ccd099d9a8e16a125692d108d23d68ef1ffb49777422ff72aff549fc51f" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-09T07:51:39+00:00"^^xsd:dateTime ;
