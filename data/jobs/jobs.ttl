<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-influencer-marketing-creator-manager-all-genders-100-home-office-frankfurt-am-main-235172> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-influencer-marketing-creator-manager-all-genders-100-home-office-frankfurt-am-main-235172/1>,
        <https://www.arbeitnow.com/jobs/companies/brainbook-brain-media-gmbh/influencer-marketing-creator-manager-all-genders-100-home-office-frankfurt-am-main-235172> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3db6f5ce8280da3aa7913047e14bf39bdb951ba3cc877f0cf8834f8e582a32b3" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-13T07:58:32+00:00"^^xsd:dateTime ;
