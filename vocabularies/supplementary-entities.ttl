@prefix okg: <https://openknowledgegraphs.com/ontology#> .
@prefix schema: <https://schema.org/> .

<https://openknowledgegraphs.com/entities/cypher> a okg:QueryLanguage,
        okg:TagEntity ;
    okg:reviewState "reviewed" ;
    schema:alternateName "Cypher",
        "openCypher" ;
    schema:description "Declarative query language for property graphs." ;
    schema:name "Cypher" .

