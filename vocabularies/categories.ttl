@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix okg: <https://openknowledgegraphs.com/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

okg:FinancialServices a skos:Concept,
        okg:Category ;
    rdfs:label "Financial services" ;
    skos:broader okg:FinanceBusiness ;
    skos:definition "Banking, investment, insurance, financial markets and financial risk."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "Financial services"@en ;
    skos:scopeNote "Salary, stock compensation and employee insurance benefits are not role-domain evidence."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "banking",
        "financial risk",
        "financial services",
        "insurance",
        "investment",
        "trading" ;
    okg:sortOrder 12 ;
    okg:urlSlug "financial-services" .

okg:Healthcare a skos:Concept,
        okg:Category ;
    rdfs:label "Healthcare" ;
    skos:broader okg:LifeSciencesHealthcare ;
    skos:definition "Clinical care, health services, patient records and medical observations."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "Healthcare"@en ;
    skos:scopeNote "Health insurance benefits in a job advertisement are not role-domain evidence."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "clinical",
        "health care",
        "healthcare",
        "medical",
        "patient" ;
    okg:sortOrder 10 ;
    okg:urlSlug "healthcare" .

okg:LifeSciences a skos:Concept,
        okg:Category ;
    rdfs:label "Life sciences" ;
    skos:broader okg:LifeSciencesHealthcare ;
    skos:definition "Biological research, molecular biology, pharmaceuticals and drug discovery."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "Life sciences"@en ;
    skos:scopeNote "An employer name alone is insufficient."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "bioinformatics",
        "biomedical",
        "drug discovery",
        "genomics",
        "pharmaceutical",
        "proteomics" ;
    okg:sortOrder 11 ;
    okg:urlSlug "life-sciences" .

okg:SupplyChain a skos:Concept,
        okg:Category ;
    rdfs:label "Supply chain and commerce" ;
    skos:broader okg:FinanceBusiness ;
    skos:definition "Products, procurement, logistics, trade and supply-chain operations."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "Supply chain and commerce"@en ;
    skos:scopeNote "A generic product-management role alone is insufficient."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "commerce",
        "logistics",
        "procurement",
        "product classification",
        "supply chain" ;
    okg:sortOrder 13 ;
    okg:urlSlug "supply-chain" .

okg:EnvironmentAgriculture a skos:Concept,
        okg:Category ;
    rdfs:label "Environment & Agriculture" ;
    skos:definition "Resources for the environment, climate, ecology, natural resources, agriculture, forestry, food production, or fisheries."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "Environment & Agriculture"@en ;
    skos:scopeNote "Use when environmental systems, conservation, land and water management, farming, crops, livestock, or food production are primary."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "agriculture",
        "climate",
        "ecology",
        "environmental",
        "farming",
        "forestry" ;
    okg:sortOrder 8 ;
    okg:urlSlug "environment-agriculture" .

okg:GeneralCrossDomain a skos:Concept,
        okg:Category ;
    rdfs:label "General / Cross-domain" ;
    skos:definition "Foundational, upper-level, broadly reusable, or genuinely multi-domain resources without one dominant subject domain."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "General / Cross-domain"@en ;
    skos:scopeNote "Assign only with evidence of cross-domain scope. Missing or inconclusive domain evidence stays unassigned; replace the existing fallback instruction."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "cross-domain",
        "foundational ontology",
        "general purpose ontology",
        "upper ontology" ;
    okg:sortOrder 9 ;
    okg:urlSlug "general-cross-domain" .

okg:Geospatial a skos:Concept,
        okg:Category ;
    rdfs:label "Geospatial" ;
    skos:definition "Resources centered on geographic location, spatial relationships, mapping, geodesy, or Earth observation."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "Geospatial"@en ;
    skos:scopeNote "Use for GIS, cartography, cadastral data, place identifiers, coordinate systems, and explicitly spatial datasets. Do not use solely because a domain can contain locations."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "GIS",
        "cartography",
        "geodesy",
        "geographic",
        "geospatial" ;
    okg:sortOrder 2 ;
    okg:urlSlug "geospatial" .

okg:GovernmentPublicSector a skos:Concept,
        okg:Category ;
    rdfs:label "Government & Public Sector" ;
    skos:definition "Resources for government, law, public administration, public services, civic institutions, or defense."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "Government & Public Sector"@en ;
    skos:scopeNote "Use when national, regional, or local public-sector operations and legal or civic information are primary. Prefer International Development for aid, humanitarian, and cross-country development programs."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "defense",
        "government",
        "legal",
        "legislation",
        "public administration" ;
    okg:sortOrder 3 ;
    okg:urlSlug "government-public-sector" .

okg:InternationalDevelopment a skos:Concept,
        okg:Category ;
    rdfs:label "International Development" ;
    skos:definition "Resources for international aid, humanitarian action, sustainable development, and cross-country social or economic development."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "International Development"@en ;
    skos:scopeNote "Use for development programs, global development indicators, humanitarian response, and aid organizations. Prefer Government & Public Sector for domestic administration and public services."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "development indicators",
        "humanitarian",
        "international development",
        "sustainable development" ;
    okg:sortOrder 4 ;
    okg:urlSlug "international-development" .

okg:LibraryCulturalHeritage a skos:Concept,
        okg:Category ;
    rdfs:label "Library & Cultural Heritage" ;
    skos:definition "Resources for libraries, archives, museums, bibliography, language, the arts, history, or cultural heritage collections."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "Library & Cultural Heritage"@en ;
    skos:scopeNote "Use for cataloging and authority data, archival description, museum collections, historical and artistic subjects, linguistic vocabularies, and cultural memory."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "archives",
        "bibliographic",
        "cultural heritage",
        "libraries",
        "library",
        "linguistic",
        "museum" ;
    okg:sortOrder 6 ;
    okg:urlSlug "library-cultural-heritage" .

okg:TechnologyWeb a skos:Concept,
        okg:Category ;
    rdfs:label "Technology & Web" ;
    skos:definition "Resources whose principal subject is computing, data technology, telecommunications, the internet, or web standards."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "Technology & Web"@en ;
    skos:scopeNote "Use for domain-specific computing and web concepts. Prefer General / Cross-domain for foundational semantic models designed to apply across subject domains."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "computing",
        "cybersecurity",
        "telecommunications",
        "web standards" ;
    okg:sortOrder 7 ;
    okg:urlSlug "technology-web" .

okg:FinanceBusiness a skos:Concept,
        okg:Category ;
    rdfs:label "Finance & Business" ;
    skos:definition "Resources for finance, accounting, markets, commerce, enterprise operations, industry, or business transactions."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "Finance & Business"@en ;
    skos:scopeNote "Use for financial instruments and institutions, corporate information, products and services, supply chains, and commercial processes."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "banking",
        "commerce",
        "finance",
        "financial",
        "supply chain" ;
    okg:sortOrder 5 ;
    okg:urlSlug "finance-business" .

okg:LifeSciencesHealthcare a skos:Concept,
        okg:Category ;
    rdfs:label "Life Sciences & Healthcare" ;
    skos:definition "Resources whose principal subject is biology, medicine, health, clinical care, biomedical research, or pharmaceuticals."@en ;
    skos:inScheme <https://openknowledgegraphs.com/vocabularies/categories> ;
    skos:prefLabel "Life Sciences & Healthcare"@en ;
    skos:scopeNote "Use for biological and biomedical subject matter, anatomy, disease, clinical practice, health services, and related life-science data. Prefer Environment & Agriculture when environmental or farming concerns are primary."@en ;
    okg:conceptKind "domain" ;
    okg:discoveryPhrase "biomedical",
        "clinical",
        "drug discovery",
        "genomics",
        "healthcare" ;
    okg:sortOrder 1 ;
    okg:urlSlug "life-sciences-healthcare" .

<https://openknowledgegraphs.com/vocabularies/categories> a skos:ConceptScheme ;
    dcterms:description "Shared domain concepts for catalog resources, software and jobs."@en ;
    dcterms:issued "2026-09-15"^^xsd:date ;
    dcterms:modified "2026-09-15"^^xsd:date ;
    dcterms:title "OKG Categories"@en ;
    vann:preferredNamespacePrefix "okg" ;
    vann:preferredNamespaceUri "https://openknowledgegraphs.com/ontology#" ;
    owl:versionInfo "1.0.0" ;
    skos:hasTopConcept okg:EnvironmentAgriculture,
        okg:FinanceBusiness,
        okg:GeneralCrossDomain,
        okg:Geospatial,
        okg:GovernmentPublicSector,
        okg:InternationalDevelopment,
        okg:LibraryCulturalHeritage,
        okg:LifeSciencesHealthcare,
        okg:TechnologyWeb ;
    okg:classificationPredicate okg:category ;
    okg:conceptClass okg:Category .
